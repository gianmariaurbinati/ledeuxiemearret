---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL.slice(0, -1) : import.meta.env.BASE_URL;
---
<Layout title="Le deuxième arrêt">
  <section class="hero">
    <div class="hero-videos">
      <video id="heroA" src={`${base}/video/hero_desktop.mp4`} muted playsinline preload="auto"></video>
      <video id="heroB" src={`${base}/video/hero_desktop.mp4`} muted playsinline preload="auto"></video>
    </div>
    <div class="hero-scrim"></div>
    <div class="hero-fade"></div>

    <div class="hero-content">
      <h1>Le deuxième arrêt</h1>
      <p class="hero-subtitle">Everyone deserves a second chance.</p>
    </div>

    <div class="hero-menu-wrap">
      <a href={`${base}/menu`} class="hero-menu">Menu</a>
    </div>

    <div class="hero-date">
      <span class="hero-day" id="heroDay">&nbsp;</span>
      <span class="hero-time" id="heroTime">&nbsp;</span>
    </div>
  </section>

  <section id="home" class="home">
    <img src={`${base}/img/monet-bg.jpg`} alt="" class="home-bg" />
    <div class="home-fade-top"></div>

    <article class="manifesto">
      <div class="manifesto-mark">
        <img src={`${base}/img/logo-cicogna-treno-oro-scontornato.png`} alt="Le deuxième arrêt" />
      </div>
      <p>In Italia può capitare che grandi film vengano riconosciuti come tali, ma che non prendano il volo.</p>
      <p class="manifesto-answer">Noi non stiamo a indagare le cause. Torniamo a guardarli e facciamo in modo che li guardino anche gli altri.</p>
    </article>

    <section class="mid-hero" aria-label="Il viaggio dei film riprende">
      <video
        id="midHeroVideo"
        src={`${base}/video/uccello-manifesto.mp4`}
        poster={`${base}/video/uccello-poster.jpg`}
        autoplay
        muted
        loop
        playsinline
        preload="auto"
      ></video>
    </section>

    <a class="menu-entry" href={`${base}/menu`}>Menu</a>
  </section>
</Layout>

<script>
  // Orologio vivo, ora di Roma
  const dayEl = document.getElementById('heroDay');
  const timeEl = document.getElementById('heroTime');

  const updateClock = () => {
    const now = new Date();
    const data = new Intl.DateTimeFormat('it-IT', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
      timeZone: 'Europe/Rome',
    }).format(now);
    const ora = new Intl.DateTimeFormat('it-IT', {
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
      timeZone: 'Europe/Rome',
    }).format(now);
    const dataCap = data.charAt(0).toUpperCase() + data.slice(1);
    if (dayEl) dayEl.textContent = dataCap;
    if (timeEl) timeEl.textContent = `${ora} — Roma`;
  };
  updateClock();
  setInterval(updateClock, 30000);

  const RATE = 0.5;
  const FADE = 1.0;

  const a = document.getElementById('heroA') as HTMLVideoElement | null;
  const b = document.getElementById('heroB') as HTMLVideoElement | null;

  if (a && b) {
    let front = a;
    let back = b;
    let fading = false;

    [a, b].forEach((v) => {
      v.muted = true;
      v.volume = 0;
      v.loop = false;
      v.defaultPlaybackRate = RATE;
      v.playbackRate = RATE;
      v.style.transition = `opacity ${FADE}s linear`;
      v.addEventListener('ratechange', () => {
        if (v.playbackRate !== RATE) v.playbackRate = RATE;
      });
      v.addEventListener('ended', () => {
        if (front !== v) { v.pause(); v.currentTime = 0; return; }
        v.currentTime = 0;
        v.style.opacity = '1';
        back.style.opacity = '0';
        fading = false;
        v.play().catch(() => {});
      });
    });

    a.style.opacity = '1';
    b.style.opacity = '0';
    a.play().catch(() => {});

    const tick = () => {
      if (front.duration) {
        const remaining = (front.duration - front.currentTime) / RATE;
        if (!fading && remaining <= FADE) {
          fading = true;
          back.currentTime = 0;
          back.playbackRate = RATE;
          back.play().catch(() => {});
          back.style.opacity = '1';
          front.style.opacity = '0';
          const prevFront = front;
          setTimeout(() => {
            prevFront.pause();
            const tmp = front;
            front = back;
            back = tmp;
            fading = false;
          }, FADE * 1000);
        }
      }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);

    document.addEventListener('visibilitychange', () => {
      if (!document.hidden && front.paused) front.play().catch(() => {});
    });
  }

  const midHeroVideo = document.getElementById('midHeroVideo') as HTMLVideoElement | null;
  if (midHeroVideo) {
    midHeroVideo.muted = true;
    midHeroVideo.loop = true;
    midHeroVideo.play().catch(() => {});

    document.addEventListener('visibilitychange', () => {
      if (!document.hidden && midHeroVideo.paused) midHeroVideo.play().catch(() => {});
    });
  }

</script>

<style>
  .hero {
    position: relative;
    height: 100vh;
    min-height: 620px;
    overflow: hidden;
    background: #0f0d0b;
  }
  .hero-videos { position: absolute; inset: 0; }
  .hero-videos video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    background: #0f0d0b;
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(12,10,8,0.42) 0%, rgba(12,10,8,0.34) 45%, rgba(12,10,8,0.72) 100%);
    pointer-events: none;
  }
  .hero-fade {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 14vh;
    min-height: 90px;
    background: linear-gradient(180deg, transparent, #0f0d0b 92%);
    pointer-events: none;
  }
  .hero-content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 22px;
    padding: 0 32px;
    pointer-events: none;
  }
  .hero-content h1 {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-weight: 300;
    font-size: clamp(58px, 8vw, 106px);
    line-height: 1;
    letter-spacing: -.025em;
    color: #f7f1e4;
    margin: 0;
    text-align: center;
    text-shadow: 0 3px 24px rgba(0,0,0,0.38);
  }
  .hero-subtitle {
    margin: 0;
    white-space: nowrap;
    font-size: clamp(18px, 1.9vw, 26px);
    font-weight: 400;
    letter-spacing: 3.5px;
    color: #d4af37;
    text-align: center;
    text-shadow: 0 2px 18px rgba(0,0,0,0.58);
  }
  .hero-menu-wrap {
    position: absolute;
    left: 0; right: 0; bottom: 38px;
    display: flex;
    justify-content: center;
  }
  .hero-menu {
    font-size: 12px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: rgba(247,241,228,0.82);
    border-bottom: 1px solid rgba(247,241,228,0.35);
    padding-bottom: 6px;
  }
  .hero-menu:hover { color: #f7f1e4; border-bottom-color: #f7f1e4; }
  .hero-date {
    position: absolute;
    right: clamp(20px,4vw,48px);
    top: clamp(28px,5vh,56px);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
    padding: 17px 27px;
    background: rgba(10,16,28,0.13);
    border: 1px solid rgba(247,241,228,0.18);
    border-radius: 6px;
    backdrop-filter: blur(2px);
    text-align: right;
  }
  .hero-day {
    white-space: nowrap;
    font-size: 21px;
    letter-spacing: 2.5px;
    color: #fdf8ec;
  }
  .hero-time {
    white-space: nowrap;
    font-size: 19px;
    letter-spacing: 2.5px;
    color: rgba(253,248,236,0.82);
  }

  .home {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: clamp(64px, 8vw, 112px);
    padding: clamp(64px, 9vh, 110px) clamp(24px, 6vw, 96px) clamp(72px, 10vh, 120px);
    overflow: hidden;
  }
  .home-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .home-fade-top {
    position: absolute;
    left: 0; right: 0; top: 0;
    height: 14vh;
    min-height: 90px;
    background: linear-gradient(180deg, #0f0d0b, transparent);
    pointer-events: none;
  }

  .manifesto {
    position: relative;
    z-index: 1;
    width: min(100%, 1180px);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 0.58fr);
    grid-template-areas:
      "header header"
      "film copy";
    column-gap: clamp(40px, 6vw, 88px);
    row-gap: clamp(40px, 5vw, 72px);
  }
  .manifesto-header {
    grid-area: header;
    display: grid;
    grid-template-columns: minmax(170px, 0.35fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 80px);
    align-items: start;
    padding-bottom: clamp(28px, 4vw, 48px);
    border-bottom: 1px solid rgba(43,38,32,0.34);
  }
  .section-caption {
    margin: 9px 0 0;
    display: flex;
    justify-content: space-between;
    gap: 20px;
    font-family: 'Cinzel', Georgia, serif;
    font-size: 11px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 2.4px;
    text-transform: uppercase;
    color: #5b5348;
  }
  .manifesto-header h2 {
    margin: 0;
    max-width: 900px;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(40px, 5.4vw, 76px);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -1.5px;
    color: #211d18;
    text-wrap: balance;
  }
  .manifesto-film {
    grid-area: film;
    margin: 0;
    min-width: 0;
  }
  .film-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #0f0d0b;
    box-shadow: 0 24px 70px rgba(28,23,17,0.22);
  }
  .film-frame video {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }
  .film-play {
    position: absolute;
    inset: 0;
    width: 100%;
    padding: clamp(22px, 4vw, 46px);
    border: 0;
    display: flex;
    align-items: flex-end;
    gap: clamp(18px, 2.5vw, 32px);
    color: #fffaf0;
    background: linear-gradient(180deg, rgba(12,10,8,0.06) 30%, rgba(12,10,8,0.78) 100%);
    text-align: left;
    cursor: pointer;
  }
  .film-play[hidden] { display: none; }
  .play-mark {
    flex: 0 0 auto;
    width: clamp(48px, 5vw, 68px);
    height: clamp(48px, 5vw, 68px);
    border: 1px solid rgba(255,250,240,0.76);
    border-radius: 50%;
    display: grid;
    place-items: center;
    padding-left: 4px;
    font-family: Arial, sans-serif;
    font-size: clamp(14px, 1.4vw, 20px);
    transition: transform 220ms ease, background-color 220ms ease;
  }
  .film-play:hover .play-mark,
  .film-play:focus-visible .play-mark {
    transform: scale(1.08);
    background: rgba(255,250,240,0.16);
  }
  .play-copy {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .play-copy small {
    font-family: 'Cinzel', Georgia, serif;
    font-size: 10px;
    letter-spacing: 2.2px;
    text-transform: uppercase;
    color: rgba(255,250,240,0.72);
  }
  .play-copy strong {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(25px, 3vw, 42px);
    font-weight: 500;
    line-height: 1;
  }
  .film-index {
    position: absolute;
    top: clamp(16px, 2vw, 26px);
    left: clamp(18px, 2.5vw, 32px);
    right: clamp(18px, 2.5vw, 32px);
    display: flex;
    justify-content: space-between;
    font-family: 'Cinzel', Georgia, serif;
    font-size: 9px;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: rgba(255,250,240,0.7);
    pointer-events: none;
  }
  .manifesto-film figcaption {
    margin-top: 16px;
    display: flex;
    justify-content: space-between;
    gap: 24px;
    font-family: 'Cinzel', Georgia, serif;
    font-size: clamp(10px, 1vw, 12px);
    line-height: 1.4;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #5a5146;
  }
  .manifesto-film figcaption strong { color: #211d18; }
  .manifesto-copy {
    grid-area: copy;
    display: flex;
    flex-direction: column;
    gap: clamp(24px, 3vw, 38px);
    padding: clamp(8px, 1vw, 16px) 0 0 clamp(20px, 3vw, 40px);
    border-left: 1px solid rgba(43,38,32,0.34);
  }
  .manifesto-copy p {
    margin: 0;
    font-size: clamp(20px, 2vw, 27px);
    font-weight: 500;
    line-height: 1.38;
    color: #2b2620;
    text-wrap: pretty;
  }
  .manifesto-note {
    margin: 12px 0 0 !important;
    padding-top: 22px;
    border-top: 1px solid rgba(43,38,32,0.22);
    font-size: clamp(15px, 1.4vw, 18px) !important;
    font-style: italic;
    font-weight: 400 !important;
    line-height: 1.5 !important;
    color: #6f675c !important;
  }

  .quote {
    position: relative;
    margin: clamp(80px, 12vh, 148px) 0 0;
    display: flex;
    flex-direction: column;
    z-index: 1;
    width: min(100%, 980px);
    align-self: center;
    align-items: center;
    gap: 22px;
  }
  .quote blockquote {
    position: relative;
    margin: 0;
    max-width: 900px;
    font-size: clamp(30px, 3.1vw, 48px);
    letter-spacing: 0.5px;
    font-family: 'Cormorant', Georgia, serif;
    font-weight: 500;
    font-style: italic;
    line-height: 1.4;
    color: #2b2620;
    text-align: center;
    text-wrap: pretty;
  }
  .quote-rule {
    position: relative;
    width: clamp(80px,10vw,160px);
    height: 1px;
    background: rgba(43,38,32,0.42);
  }
  .quote figcaption {
    position: relative;
    white-space: nowrap;
    font-size: 16px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: #4a443a;
  }

  .site-nav {
    position: relative;
    z-index: 1;
    align-self: center;
    width: min(100%, 1180px);
    padding-top: clamp(28px, 4vw, 52px);
    border-top: 1px solid rgba(43,38,32,0.28);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    row-gap: 14px;
    column-gap: clamp(24px, 3vw, 48px);
  }
  .site-nav a {
    position: relative;
    font-size: clamp(15px, 1.35vw, 19px);
    font-weight: 600;
    letter-spacing: 3.5px;
    text-transform: uppercase;
    color: #2b2620;
    padding: 6px 2px;
    border-bottom: 1px solid transparent;
  }
  .site-nav a:hover {
    color: #000000;
    border-bottom-color: rgba(43,38,32,0.55);
  }

  @media (max-width: 900px) {
    .home {
      gap: 64px;
      padding: 120px 24px 72px;
    }
    .manifesto {
      grid-template-columns: 1fr;
      grid-template-areas:
        "header"
        "film"
        "copy";
      gap: 52px;
    }
    .manifesto-header {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .section-caption { max-width: 300px; }
    .manifesto-copy {
      max-width: 680px;
      padding-left: 24px;
    }
    .quote {
      margin: 0;
    }
    .quote blockquote {
      max-width: 620px;
      text-align: center;
    }
    .quote figcaption {
      white-space: normal;
      text-align: center;
    }
  }

  @media (max-width: 560px) {
    .hero-content {
      gap: 10px;
      padding: 0 24px;
    }
    .hero-content h1 {
      max-width: 92vw;
      font-size: clamp(40px, 12.5vw, 54px);
      line-height: 1.04;
    }
    .hero-subtitle {
      white-space: normal;
      font-size: 12px;
      line-height: 1.4;
      letter-spacing: 1.6px;
    }
    .hero-date {
      top: 16px;
      right: 14px;
      gap: 3px;
      padding: 9px 12px;
    }
    .hero-day { font-size: 11px; letter-spacing: 1.4px; }
    .hero-time { font-size: 10px; letter-spacing: 1.3px; }
    .hero-menu { font-size: 9px; letter-spacing: 3px; }
    .manifesto-header h2 {
      font-size: clamp(42px, 13vw, 62px);
      line-height: 1;
    }
    .manifesto-film figcaption {
      flex-direction: column;
      gap: 4px;
    }
    .film-index { display: none; }
    .film-play { padding: 18px; }
    .play-copy small { letter-spacing: 1.4px; }
    .manifesto-copy p {
      font-size: 20px;
      line-height: 1.45;
    }
    .quote blockquote {
      font-size: 30px;
      line-height: 1.32;
    }
    .site-nav {
      flex-direction: column;
      row-gap: 10px;
    }
  }

  .manifesto-mark {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
    margin: 0 auto;
  }
  .manifesto-mark img {
    width: clamp(88px, 9.5vw, 136px);
    height: auto;
    display: block;
    opacity: .94;
  }

  .manifesto {
    position: relative;
    z-index: 1;
    width: min(100%, 680px);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 2.6vw, 30px);
    padding: 0 0 clamp(28px, 4vw, 52px);
    border-bottom: 1px solid rgba(43,38,32,0.3);
    text-align: center;
  }
  .manifesto p {
    margin: 0;
    font-family: 'Bodoni Moda', 'Bodoni MT', Didot, Georgia, serif;
    font-size: clamp(22px, 2.3vw, 31px);
    font-style: normal;
    font-weight: 500;
    line-height: 1.42;
    letter-spacing: -.012em;
    color: #211d18;
    text-wrap: pretty;
  }
  .manifesto-answer {
    font-size: clamp(19px, 1.85vw, 24px) !important;
    font-weight: 400 !important;
    color: #4a443a !important;
  }
  .mid-hero {
    position: relative;
    z-index: 1;
    width: 100vw;
    height: min(76vh, 820px);
    min-height: 480px;
    margin-left: calc(50% - 50vw);
    overflow: hidden;
    background: #0f0d0b;
  }
  .mid-hero video {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }
  .menu-entry {
    position: relative;
    z-index: 1;
    align-self: center;
    display: inline-block;
    padding: 10px 28px 16px;
    font-family: 'Cinzel', Georgia, serif;
    font-size: clamp(44px, 8vw, 112px);
    font-weight: 400;
    line-height: 1;
    letter-spacing: clamp(6px, 1vw, 16px);
    text-transform: uppercase;
    color: #211d18;
    border-bottom: 1px solid rgba(43,38,32,0.42);
    transition: letter-spacing 260ms ease, color 260ms ease;
  }
  .menu-entry:hover,
  .menu-entry:focus-visible {
    color: #000;
    letter-spacing: clamp(8px, 1.3vw, 20px);
  }

  @media (max-width: 760px) {
    .home {
      gap: 52px;
      padding: 96px 22px 64px;
    }
    .manifesto {
      gap: 22px;
      padding: 30px 0;
    }
    .manifesto p {
      font-size: clamp(21px, 5.8vw, 28px);
      line-height: 1.34;
    }
    .manifesto-mark img { width: clamp(44px, 11vw, 60px); }
    .mid-hero {
      height: 58vh;
      min-height: 360px;
    }
    .menu-entry {
      font-size: clamp(34px, 12vw, 56px);
      letter-spacing: 5px;
    }
  }
</style>
