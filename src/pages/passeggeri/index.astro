---
import Layout from '../../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL.slice(0, -1) : import.meta.env.BASE_URL;
---
<Layout title="Passeggeri — Le deuxième arrêt">
  <section class="passeggeri">
    <img src={`${base}/img/gare-saint-lazare.jpg`} alt="" class="bg" />
    <div class="scrim"></div>

    <div class="inner">
      <div class="row">

        <div class="col">
          <button id="toggle" class="toggle-btn">
            <span id="icon" class="passenger-mark" aria-hidden="true"></span>
            <span class="titolo">Passeggeri in Attesa</span>
          </button>
          <div id="reveal" class="reveal" hidden>
            <p class="prossimamente">Prossimamente</p>
            <p class="bold">Una rubrica per i registi che hanno un'opera ferma.</p>
            <p class="italic">Scriviamo di film che il mercato ha dimenticato.</p>
          </div>
        </div>

        <div class="col col-right">
          <div class="spacer" aria-hidden="true"></div>
          <span class="titolo">Passeggeri a Bordo</span>
        </div>

      </div>
    </div>
  </section>
</Layout>

<script>
  const btn = document.getElementById('toggle');
  const icon = document.getElementById('icon');
  const reveal = document.getElementById('reveal');
  let open = false;
  btn?.addEventListener('click', () => {
    open = !open;
    if (reveal) reveal.hidden = !open;
    if (icon) icon.style.transform = `rotate(${open ? 45 : 0}deg)`;
  });
</script>

<style>
  .passeggeri {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
  }
  .bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .scrim {
    position: absolute;
    inset: 0;
    background: rgba(20,18,14,0.12);
    pointer-events: none;
  }
  .inner {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 6vw;
  }
  .row {
    width: 100%;
    max-width: 1400px;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: nowrap;
  }

  .col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }
  .col-right { align-items: flex-end; }

  /* Occupa esattamente lo spazio del pennello + gap, così i due titoli
     restano sulla stessa riga di base in ogni stato. */
  .spacer {
    height: 40px;
    margin-bottom: 0;
  }

  .toggle-btn {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    font-family: inherit;
  }
  .toggle-btn:hover { opacity: 0.75; }
  .passenger-mark {
    position: relative;
    width: 48px;
    height: 48px;
    border: 1px solid rgba(43,38,32,.62);
    border-radius: 50%;
    transition: transform .45s cubic-bezier(.16,1,.3,1), border-color .3s ease;
  }
  .passenger-mark::before,
  .passenger-mark::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 16px;
    height: 1px;
    background: #2b2620;
    transform: translate(-50%, -50%);
  }
  .passenger-mark::after { transform: translate(-50%, -50%) rotate(90deg); }
  .toggle-btn:hover .passenger-mark { border-color: #2b2620; }

  .titolo {
    display: block;
    white-space: nowrap;
    font-size: clamp(18px, 2.4vw, 38px);
    font-weight: 600;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: #2b2620;
    text-shadow: 0 1px 2px rgba(255,255,255,0.4);
    line-height: 1.2;
  }

  .reveal {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    margin-top: 52px;
    font-size: clamp(17px, 1.9vw, 24px);
    line-height: 1.6;
    letter-spacing: 0.5px;
    color: #241f19;
    text-shadow: 0 1px 3px rgba(255,255,255,0.55);
  }
  .reveal p { margin: 0; }
  .prossimamente { font-style: italic; }
  .bold { font-weight: 500; }
  .italic {
    font-size: clamp(14px, 1.6vw, 19px);
    font-style: italic;
    opacity: 0.85;
  }

  @media (max-width: 700px) {
    .inner { padding: 0 14px; }
    .row { gap: 10px; }
    .col { min-width: 0; }
    .passenger-mark { width: 34px; height: 34px; }
    .toggle-btn { gap: 5px; }
    .spacer { height: 25px; }
    .titolo {
      font-size: clamp(11px, 3.25vw, 15px);
      letter-spacing: 1.15px;
    }
    .reveal {
      width: min(88vw, 520px);
      margin-top: 34px;
      font-size: clamp(15px, 4.2vw, 19px);
    }
  }
</style>
