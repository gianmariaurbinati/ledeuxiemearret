---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL.slice(0, -1) : import.meta.env.BASE_URL;

const voices = [
  { label: 'Il Treno', href: null },
  { label: 'Rubriche', href: `${base}/rubriche` },
  { label: 'News', href: null },
  { label: 'Autori Emergenti', href: null },
  { label: 'Passeggeri', href: `${base}/passeggeri` },
];
---

<Layout title="Menu — Le deuxième arrêt">
  <main class="menu-page">
    <div class="menu-media" aria-hidden="true">
      <video id="menuVideoA" src={`${base}/video/menu-background.mp4`} muted playsinline preload="auto"></video>
      <video id="menuVideoB" src={`${base}/video/menu-background.mp4`} muted playsinline preload="auto"></video>
      <div class="menu-video-veil"></div>
    </div>
    <header class="menu-header">
      <a href={`${base}/`} class="back">Le deuxième arrêt</a>
      <span>Indice generale</span>
    </header>

    <div class="brand-mark">
      <img class="brand-logo" src={`${base}/img/logo-cicogna-contorno-blu.png`} alt="Cicogna bianca con ali d'alloro — Le deuxième arrêt" />
      <div class="brand-wordmark">
        <strong>Le deuxième arrêt</strong>
        <span>Films · regards · secondes vies</span>
      </div>
    </div>

    <nav class="menu-list" aria-label="Menu principale">
      {voices.map((voice, index) => (
        voice.href ? (
          <a href={voice.href} class="menu-item">
            <span class="number">{String(index + 1).padStart(2, '0')}</span>
            <span class="label">{voice.label}</span>
          </a>
        ) : (
          <div class="menu-item is-coming" aria-label={`${voice.label}, prossimamente`}>
            <span class="number">{String(index + 1).padStart(2, '0')}</span>
            <span class="label">{voice.label}</span>
            <span class="status">Prossimamente</span>
          </div>
        )
      ))}
    </nav>
  </main>
</Layout>

<script>
  const videoA = document.getElementById('menuVideoA') as HTMLVideoElement | null;
  const videoB = document.getElementById('menuVideoB') as HTMLVideoElement | null;
  const fadeDuration = 1.2;

  if (videoA && videoB) {
    let front = videoA;
    let back = videoB;
    let fading = false;

    [videoA, videoB].forEach((video) => {
      video.muted = true;
      video.loop = false;
      video.style.transition = `opacity ${fadeDuration}s linear`;
      video.addEventListener('ended', () => {
        if (video === front) {
          video.currentTime = 0;
          video.play().catch(() => {});
        }
      });
    });

    videoA.style.opacity = '1';
    videoB.style.opacity = '0';
    videoA.play().catch(() => {});

    const keepLooping = () => {
      if (front.duration && !fading && front.duration - front.currentTime <= fadeDuration) {
        fading = true;
        back.currentTime = 0;
        back.play().catch(() => {});
        back.style.opacity = '1';
        front.style.opacity = '0';
        const previous = front;
        setTimeout(() => {
          previous.pause();
          previous.currentTime = 0;
          [front, back] = [back, previous];
          fading = false;
        }, fadeDuration * 1000);
      }
      requestAnimationFrame(keepLooping);
    };
    requestAnimationFrame(keepLooping);

    document.addEventListener('visibilitychange', () => {
      if (!document.hidden && front.paused) front.play().catch(() => {});
    });
  }
</script>

<style>
  .menu-page {
    position: relative;
    min-height: 100vh;
    padding: clamp(28px, 5vw, 72px) clamp(22px, 6vw, 96px) clamp(60px, 9vw, 120px);
    background: #e8dfd0;
  }
  .menu-media {
    position: fixed;
    inset: 0;
    overflow: hidden;
    z-index: 0;
    background: #e8dfd0;
    pointer-events: none;
  }
  .menu-media video {
    position: absolute;
    inset: -4%;
    width: 108%;
    height: 108%;
    object-fit: cover;
    filter: saturate(.72) contrast(.9);
  }
  .menu-video-veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(rgba(232,223,208,.72), rgba(232,223,208,.78)),
      radial-gradient(circle at 50% 20%, transparent 0%, rgba(232,223,208,.25) 78%);
  }
  .menu-header,
  .brand-mark,
  .menu-list {
    position: relative;
    z-index: 1;
  }
  .menu-header {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding-bottom: clamp(28px, 5vw, 58px);
    border-bottom: 1px solid rgba(43,38,32,0.4);
    font-family: 'Cinzel', Georgia, serif;
    font-size: 11px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: #514a40;
  }
  .back { color: #211d18; }
  .menu-list {
    display: flex;
    flex-direction: column;
  }
  .brand-mark {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: clamp(24px, 3vw, 40px) 0 clamp(28px, 4vw, 50px);
    background: transparent;
    border-bottom: 1px solid rgba(43,38,32,0.28);
  }
  .brand-logo {
    display: block;
    width: clamp(68px, 7vw, 92px);
    height: auto;
  }
  .brand-wordmark {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    color: #19233c;
    text-align: center;
  }
  .brand-wordmark strong {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(24px, 2.8vw, 36px);
    font-style: italic;
    font-weight: 300;
    line-height: 1;
  }
  .brand-wordmark span {
    font-family: 'Cinzel', Georgia, serif;
    font-size: 8px;
    letter-spacing: .28em;
    text-transform: uppercase;
    color: rgba(25,35,60,.58);
  }
  .menu-item {
    min-height: clamp(84px, 9vw, 118px);
    display: grid;
    grid-template-columns: clamp(44px, 7vw, 96px) minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(14px, 3vw, 42px);
    border-bottom: 1px solid rgba(43,38,32,0.28);
    color: #211d18;
  }
  a.menu-item {
    transition: padding-left 260ms ease, color 260ms ease;
  }
  a.menu-item:hover,
  a.menu-item:focus-visible {
    padding-left: clamp(8px, 1.3vw, 20px);
    color: #6d1f2f;
  }
  .number,
  .status {
    font-family: 'Cinzel', Georgia, serif;
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
  }
  .number { color: #7b7265; }
  .label {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(30px, 4.4vw, 62px);
    font-style: italic;
    font-weight: 300;
    line-height: 1;
    letter-spacing: -.025em;
  }
  .status { color: #8a8174; }
  .is-coming { color: rgba(33,29,24,0.46); }

  @media (max-width: 680px) {
    .menu-header { align-items: flex-start; }
    .menu-item {
      grid-template-columns: 34px minmax(0, 1fr);
      min-height: 82px;
    }
    .label {
      font-size: clamp(26px, 8.5vw, 38px);
      letter-spacing: -.02em;
    }
    .status {
      grid-column: 2;
      margin-top: -24px;
      padding-bottom: 18px;
    }
  }
</style>
