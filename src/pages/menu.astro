---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL.slice(0, -1) : import.meta.env.BASE_URL;

const voices = [
  { label: 'Il Treno', href: null },
  { label: 'Rubriche', href: `${base}/rubriche` },
  { label: 'News', href: null },
  { label: 'Autori Emergenti', href: null },
  { label: 'Passeggeri', href: `${base}/passeggeri` },
];
---

<Layout title="Menu — Le deuxième arrêt">
  <main class="menu-page">
    <div class="menu-media" aria-hidden="true">
      <video id="menuVideoA" src={`${base}/video/menu-background.mp4`} muted playsinline preload="auto"></video>
      <video id="menuVideoB" src={`${base}/video/menu-background.mp4`} muted playsinline preload="auto"></video>
      <div class="menu-video-veil"></div>
    </div>

    <header class="menu-header">
      <a href={`${base}/`} class="back">Le deuxième arrêt</a>
      <span>Indice generale</span>
    </header>

    <section class="menu-stage" aria-label="Indice generale">
      <nav class="menu-list" aria-label="Menu principale">
        {voices.map((voice) => (
          voice.href ? (
            <a href={voice.href} class="menu-item">
              <span class="label">{voice.label}</span>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          ) : (
            <div class="menu-item is-coming" aria-label={`${voice.label}, prossimamente`}>
              <span class="label">{voice.label}</span>
              <span class="status">Presto</span>
            </div>
          )
        ))}
      </nav>
    </section>
    <div class="brand-seal">
      <img class="brand-logo" src={`${base}/img/logo-cicogna-contorno-blu.png`} alt="Cicogna bianca con ali d'alloro — Le deuxième arrêt" />
    </div>
  </main>
</Layout>

<script>
  const videoA = document.getElementById('menuVideoA') as HTMLVideoElement | null;
  const videoB = document.getElementById('menuVideoB') as HTMLVideoElement | null;
  const fadeDuration = 1.2;

  if (videoA && videoB) {
    let front = videoA;
    let back = videoB;
    let fading = false;

    [videoA, videoB].forEach((video) => {
      video.muted = true;
      video.loop = false;
      video.style.transition = `opacity ${fadeDuration}s linear`;
      video.addEventListener('ended', () => {
        if (video === front) {
          video.currentTime = 0;
          video.play().catch(() => {});
        }
      });
    });

    videoA.style.opacity = '1';
    videoB.style.opacity = '0';
    videoA.play().catch(() => {});

    const keepLooping = () => {
      if (front.duration && !fading && front.duration - front.currentTime <= fadeDuration) {
        fading = true;
        back.currentTime = 0;
        back.play().catch(() => {});
        back.style.opacity = '1';
        front.style.opacity = '0';
        const previous = front;
        setTimeout(() => {
          previous.pause();
          previous.currentTime = 0;
          [front, back] = [back, previous];
          fading = false;
        }, fadeDuration * 1000);
      }
      requestAnimationFrame(keepLooping);
    };
    requestAnimationFrame(keepLooping);

    document.addEventListener('visibilitychange', () => {
      if (!document.hidden && front.paused) front.play().catch(() => {});
    });
  }
</script>

<style>
  .menu-page { position: relative; min-height: 100vh; padding: clamp(24px,3.2vw,48px) clamp(20px,5vw,80px) clamp(36px,5vw,72px); overflow: hidden; background: #090909; }
  .menu-media { position: fixed; inset: 0; overflow: hidden; z-index: 0; background: #11100e; pointer-events: none; }
  .menu-media video { position: absolute; inset: -2%; width: 104%; height: 104%; object-fit: cover; filter: saturate(.9) contrast(1.04) brightness(.92); }
  .menu-video-veil { position: absolute; inset: 0; background: linear-gradient(90deg,rgba(0,0,0,.38) 0%,transparent 38%), linear-gradient(180deg,rgba(0,0,0,.18),transparent 34%,rgba(0,0,0,.22)); }
  .menu-header, .menu-stage, .brand-seal { position: relative; z-index: 1; }
  .menu-header { display: flex; justify-content: space-between; gap: 24px; font-family: Arial,Helvetica,sans-serif; font-size: 10px; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; color: rgba(255,255,255,.62); }
  .back { color: #f7f1e4; }
  .menu-stage { position: absolute; left: clamp(20px,5vw,80px); bottom: clamp(42px,8vh,92px); width: min(340px,calc(100vw - 40px)); }
  .menu-list { display: flex; flex-direction: column; align-items: flex-start; gap: 9px; }
  .menu-item { display: flex; align-items: baseline; gap: 12px; padding: 2px 0; color: #fff; font-family: Arial,Helvetica,sans-serif; text-shadow: 0 2px 18px rgba(0,0,0,.8); }
  a.menu-item { transition: opacity 200ms ease,transform 200ms ease; }
  a.menu-item:hover, a.menu-item:focus-visible { transform: translateX(5px); }
  .label { font-size: clamp(17px,1.65vw,23px); font-weight: 500; line-height: 1.15; letter-spacing: -.02em; }
  .status { font-size: 8px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; color: rgba(255,255,255,.42); }
  .arrow { font-size: 13px; color: rgba(255,255,255,.72); transition: transform 200ms ease; }
  a.menu-item:hover .arrow, a.menu-item:focus-visible .arrow { transform: translateX(4px); }
  .is-coming { color: rgba(255,255,255,.4); }
  .brand-seal { position: absolute; right: clamp(20px,5vw,80px); bottom: clamp(36px,6vh,68px); }
  .brand-logo { display: block; width: 28px; height: auto; }

  @media (max-width: 820px) {
    .menu-header { align-items: flex-start; font-size: 8px; }
    .menu-stage { left: 20px; bottom: 54px; width: calc(100vw - 74px); }
    .menu-list { gap: 8px; }
    .label { font-size: 18px; }
    .brand-seal { right: 20px; bottom: 54px; }
    .menu-video-veil { background: linear-gradient(90deg,rgba(0,0,0,.42),transparent 78%), linear-gradient(180deg,rgba(0,0,0,.16),transparent 30%,rgba(0,0,0,.3)); }
  }
</style>
