---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL.slice(0, -1) : import.meta.env.BASE_URL;

const voices = [
  { label: 'Il Treno', href: null },
  { label: 'Rubriche', href: `${base}/rubriche` },
  { label: 'News', href: null },
  { label: 'Autori Emergenti', href: null },
  { label: 'Passeggeri', href: `${base}/passeggeri` },
];
---

<Layout title="Menu — Le deuxième arrêt">
  <main class="menu-page">
    <div class="menu-media" aria-hidden="true">
      <video id="menuVideoA" src={`${base}/video/menu-background.mp4`} muted playsinline preload="auto"></video>
      <video id="menuVideoB" src={`${base}/video/menu-background.mp4`} muted playsinline preload="auto"></video>
      <div class="menu-video-veil"></div>
    </div>

    <header class="menu-header">
      <a href={`${base}/`} class="back">Le deuxième arrêt</a>
      <span>Indice generale</span>
    </header>

    <section class="menu-stage" aria-labelledby="menu-title">
      <p class="menu-kicker" id="menu-title">Menu</p>
      <nav class="menu-list" aria-label="Menu principale">
        {voices.map((voice, index) => (
          voice.href ? (
            <a href={voice.href} class="menu-item">
              <span class="number">{String(index + 1).padStart(2, '0')}</span>
              <span class="label">{voice.label}</span>
              <span class="arrow" aria-hidden="true">↗</span>
            </a>
          ) : (
            <div class="menu-item is-coming" aria-label={`${voice.label}, prossimamente`}>
              <span class="number">{String(index + 1).padStart(2, '0')}</span>
              <span class="label">{voice.label}</span>
              <span class="status">Prossimamente</span>
            </div>
          )
        ))}
      </nav>
      <div class="brand-seal">
        <img class="brand-logo" src={`${base}/img/logo-cicogna-contorno-blu.png`} alt="Cicogna bianca con ali d'alloro — Le deuxième arrêt" />
        <span>Films · regards · secondes vies</span>
      </div>
    </section>
  </main>
</Layout>

<script>
  const videoA = document.getElementById('menuVideoA') as HTMLVideoElement | null;
  const videoB = document.getElementById('menuVideoB') as HTMLVideoElement | null;
  const fadeDuration = 1.2;

  if (videoA && videoB) {
    let front = videoA;
    let back = videoB;
    let fading = false;

    [videoA, videoB].forEach((video) => {
      video.muted = true;
      video.loop = false;
      video.style.transition = `opacity ${fadeDuration}s linear`;
      video.addEventListener('ended', () => {
        if (video === front) {
          video.currentTime = 0;
          video.play().catch(() => {});
        }
      });
    });

    videoA.style.opacity = '1';
    videoB.style.opacity = '0';
    videoA.play().catch(() => {});

    const keepLooping = () => {
      if (front.duration && !fading && front.duration - front.currentTime <= fadeDuration) {
        fading = true;
        back.currentTime = 0;
        back.play().catch(() => {});
        back.style.opacity = '1';
        front.style.opacity = '0';
        const previous = front;
        setTimeout(() => {
          previous.pause();
          previous.currentTime = 0;
          [front, back] = [back, previous];
          fading = false;
        }, fadeDuration * 1000);
      }
      requestAnimationFrame(keepLooping);
    };
    requestAnimationFrame(keepLooping);

    document.addEventListener('visibilitychange', () => {
      if (!document.hidden && front.paused) front.play().catch(() => {});
    });
  }
</script>

<style>
  .menu-page { position: relative; min-height: 100vh; padding: clamp(24px,3.2vw,48px) clamp(20px,5vw,80px) clamp(36px,5vw,72px); overflow: hidden; background: #090909; }
  .menu-media { position: fixed; inset: 0; overflow: hidden; z-index: 0; background: #11100e; pointer-events: none; }
  .menu-media video { position: absolute; inset: -2%; width: 104%; height: 104%; object-fit: cover; filter: saturate(.9) contrast(1.04) brightness(.92); }
  .menu-video-veil { position: absolute; inset: 0; background: linear-gradient(180deg,rgba(0,0,0,.24) 0%,rgba(0,0,0,.08) 42%,rgba(0,0,0,.3) 100%); }
  .menu-header, .menu-stage { position: relative; z-index: 1; }
  .menu-header { display: flex; justify-content: space-between; gap: 24px; padding-bottom: clamp(18px,2vw,28px); border-bottom: 1px solid rgba(247,241,228,.3); font-family: 'Cinzel',Georgia,serif; font-size: 10px; letter-spacing: 2.5px; text-transform: uppercase; color: rgba(247,241,228,.58); }
  .back { color: #f7f1e4; }
  .menu-stage { width: min(100%,880px); margin: 0 auto; padding-top: clamp(34px,6vh,76px); }
  .menu-kicker { margin: 0 0 clamp(18px,3vh,34px); font-family: 'Cinzel',Georgia,serif; font-size: 9px; letter-spacing: .42em; text-align: center; text-transform: uppercase; color: rgba(255,255,255,.7); }
  .menu-list { display: flex; flex-direction: column; background: rgba(0,0,0,.08); }
  .menu-item { min-height: clamp(66px,8.2vh,92px); display: grid; grid-template-columns: 42px minmax(0,1fr) auto; align-items: center; gap: clamp(14px,2.5vw,32px); padding: 12px clamp(6px,1vw,12px); border-top: 1px solid rgba(255,255,255,.34); color: #fff; text-shadow: 0 2px 18px rgba(0,0,0,.65); }
  .menu-item:last-child { border-bottom: 1px solid rgba(247,241,228,.25); }
  a.menu-item { transition: color 260ms ease; }
  a.menu-item:hover, a.menu-item:focus-visible { color: #d4af37; }
  .number, .status { font-family: 'Cinzel',Georgia,serif; font-size: 8px; letter-spacing: .2em; text-transform: uppercase; }
  .number { color: rgba(255,255,255,.6); }
  .label { font-family: 'Cinzel',Georgia,serif; font-size: clamp(20px,2.6vw,34px); font-style: normal; font-weight: 400; line-height: 1.1; letter-spacing: .08em; text-transform: uppercase; }
  .status { color: rgba(255,255,255,.52); }
  .arrow { font-family: Georgia,serif; font-size: 18px; color: rgba(247,241,228,.42); transition: transform 260ms ease,color 260ms ease; }
  a.menu-item:hover .arrow, a.menu-item:focus-visible .arrow { transform: translate(4px,-4px); color: #d4af37; }
  .is-coming { color: rgba(255,255,255,.48); }
  .brand-seal { margin-top: clamp(22px,4vh,42px); display: flex; flex-direction: column; align-items: center; gap: 8px; }
  .brand-logo { display: block; width: 36px; height: auto; }
  .brand-seal span { font-family: 'Cinzel',Georgia,serif; font-size: 6px; letter-spacing: .24em; text-transform: uppercase; color: rgba(255,255,255,.5); }

  @media (max-width: 820px) {
    .menu-header { align-items: flex-start; }
    .menu-stage { padding-top: 32px; }
    .menu-item { grid-template-columns: 30px minmax(0,1fr); min-height: 70px; }
    .label { font-size: clamp(18px,5.3vw,26px); letter-spacing: .06em; }
    .status, .arrow { grid-column: 2; margin-top: -6px; }
  }
</style>
