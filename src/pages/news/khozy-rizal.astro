---
import Layout from '../../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL.slice(0, -1) : import.meta.env.BASE_URL;

const heroVideo = `${base}/video/khozy-rizal-hero.mp4`;
const heroPoster = `${base}/img/khozy-rizal-hero-poster.jpg`;
const shortverseUrl = 'https://www.shortverse.com/films/basri-salma-in-a-never-ending-comedy';
const trailerEmbed = 'https://www.youtube-nocookie.com/embed/_9hyQvpbix0?autoplay=1&mute=1&loop=1&playlist=_9hyQvpbix0&controls=1&rel=0&playsinline=1';

const filmografia = [
  { anno: '2021', titolo: 'Makassar Is a City for Football Fans', nota: 'Sundance Film Festival' },
  { anno: '2021', titolo: 'Lika Liku Laki' },
  { anno: '2022', titolo: 'Ride to Nowhere' },
  { anno: '2023', titolo: 'Basri & Salma in a Never-Ending Comedy', nota: 'Concorso, Festival di Cannes' },
  { anno: '2023', titolo: 'The Last Night in Korea' },
  { anno: '2024', titolo: 'Little Rebels Cinema Club', nota: 'Orso di Cristallo, Berlinale 2025' },
  { anno: '2026', titolo: 'Mothers Are Mothering' },
];
---
<Layout title="Khozy Rizal — Scoperte dal mondo — Le Deuxième Arrêt">
  <main class="kr" id="top">

    <!-- ═══════════════ TESTATA ═══════════════ -->
    <header class="kr-header">
      <a href={`${base}/`} class="kr-brand" aria-label="Le Deuxième Arrêt, home">
        <span class="kr-mark" aria-hidden="true">II</span>
        <span class="kr-brand-name">Le deuxième arrêt</span>
      </a>
      <a href={`${base}/news`} class="kr-back">← News</a>
    </header>

    <!-- ═══════════════ HERO A TUTTA PAGINA + BIOGRAFIA IN SOVRAIMPRESSIONE ═══════════════ -->
    <section class="kr-hero" aria-labelledby="kr-title">
      <div class="kr-hero-bg" aria-hidden="true">
        <video
          id="krHeroVideo"
          src={heroVideo}
          poster={heroPoster}
          autoplay
          muted
          loop
          playsinline
          preload="auto"
        ></video>
        <div class="kr-hero-veil"></div>
      </div>

      <div class="kr-hero-content">
        <div class="kr-hero-inner">
          <p class="kr-eyebrow">Scoperte dal mondo <span aria-hidden="true">·</span> 01</p>
          <h1 id="kr-title">Khozy Rizal</h1>
          <p class="kr-role">Regista e sceneggiatore <span aria-hidden="true">—</span> Makassar, Indonesia</p>

          <div class="kr-hero-bio">
            <p><span class="kr-dropcap">K</span>hozy Rizal nasce e lavora a Makassar, nel Sulawesi meridionale. Autodidatta, cresciuto lontano dalle scuole di cinema tradizionali, costruisce nel tempo uno stile personale che intreccia ironia, commedia nera, assurdo e osservazione sociale.</p>
            <p>I suoi film tornano spesso su famiglia, matrimonio, sessualità, identità queer e pressione sociale, con un tono che resta leggero solo in apparenza. Il riconoscimento internazionale arriva con <em>Makassar Is a City for Football Fans</em>, selezionato al Sundance Film Festival, e si consolida con <em>Basri &amp; Salma in a Never-Ending Comedy</em>, in concorso al Festival di Cannes nel 2023.</p>
            <p>Con <em>Little Rebels Cinema Club</em>, Rizal vince l'Orso di Cristallo alla Berlinale 2025, confermando la propria presenza nel circuito dei festival. Ha inoltre preso parte a programmi di formazione come Locarno Filmmakers Academy, Berlinale Talents e Busan Asian Film Academy.</p>
          </div>

          <a href={shortverseUrl} target="_blank" rel="noopener" class="kr-cta">Guarda il corto su Shortverse <span aria-hidden="true">↗</span></a>
        </div>

        <aside class="kr-hero-filmo" aria-labelledby="kr-filmo-title">
          <div class="kr-filmo-head">
            <p class="kr-label">Filmografia essenziale</p>
            <h2 id="kr-filmo-title" class="kr-visually-hidden">Filmografia</h2>
            <p class="kr-filmo-count">01 — 07</p>
          </div>

          <ol class="kr-filmo-list">
            {filmografia.map((f, i) => (
              <li>
                <span class="kr-filmo-num">{String(i + 1).padStart(2, '0')}</span>
                <span class="kr-filmo-year">{f.anno}</span>
                <span class="kr-filmo-title">{f.titolo}</span>
                {f.nota && <span class="kr-filmo-note">{f.nota}</span>}
              </li>
            ))}
          </ol>
        </aside>
      </div>

      <p class="kr-scroll">Scorri</p>
    </section>

    <!-- ═══════════════ IL CORTO ═══════════════ -->
    <section class="kr-feature" aria-labelledby="kr-feature-title">
      <p class="kr-label">In evidenza</p>

      <div class="kr-feature-card">
        <div class="kr-feature-copy">
          <h2 id="kr-feature-title">Basri &amp; Salma in a Never-Ending Comedy</h2>
          <p class="kr-feature-synopsis">Basri e Salma sono una coppia sposata a Makassar. Quello che doveva essere un pranzo di famiglia si trasforma in un confronto che esplode all'improvviso, portando a galla la domanda che aleggiava da tempo: perché la coppia non è ancora riuscita ad avere un figlio.</p>

          <div class="kr-feature-badges">
            <span>Sundance</span>
            <span>Cannes 2023</span>
            <span>Odense IFF</span>
          </div>

          <div class="kr-feature-meta">
            <p><span>Durata</span>15 minuti</p>
            <p><span>Genere</span>Commedia</p>
            <p><span>Tecnica</span>Live-Action</p>
          </div>

          <a href={shortverseUrl} target="_blank" rel="noopener" class="kr-feature-link">Guarda su Shortverse <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <!-- ═══════════════ IL TRAILER A TUTTA PAGINA ═══════════════ -->
    <section class="kr-trailer" aria-labelledby="kr-trailer-title">
      <div class="kr-trailer-bg" aria-hidden="true">
        <div class="kr-trailer-embed">
          <iframe
            src={trailerEmbed}
            title="Little Rebels Cinema Club — Trailer"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
        <div class="kr-trailer-veil"></div>
      </div>

      <div class="kr-trailer-content">
        <p class="kr-label">Il trailer</p>
        <h2 id="kr-trailer-title">Little Rebels Cinema Club</h2>
        <p class="kr-trailer-sub">Orso di Cristallo alla Berlinale 2025 <span aria-hidden="true">·</span> Filmfest Osnabrück, selezione ufficiale</p>
      </div>
    </section>

  </main>
</Layout>

<script>
  const heroVideo = document.getElementById('krHeroVideo') as HTMLVideoElement | null;

  if (heroVideo) {
    const ensurePlayback = () => {
      heroVideo.muted = true;
      heroVideo.loop = true;
      if (heroVideo.paused) heroVideo.play().catch(() => {});
    };

    ensurePlayback();
    heroVideo.addEventListener('canplay', ensurePlayback);
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) ensurePlayback();
    });
  }
</script>

<style>
  .kr {
    --black:  #08090a;
    --yellow: #f2ec3c;
    --white:  #ffffff;
    --dim:    rgba(255,255,255,.62);
    --faint:  rgba(255,255,255,.4);
    --line:   rgba(255,255,255,.15);

    min-height: 100vh;
    overflow-x: hidden;
    background: var(--black);
    color: var(--white);
    font-family: Arial, Helvetica, sans-serif;
  }

  .kr-visually-hidden {
    position: absolute;
    width: 1px; height: 1px;
    margin: -1px; padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .kr-label {
    margin: 0 0 clamp(18px, 2.4vw, 30px);
    color: var(--yellow);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .24em;
    text-transform: uppercase;
  }

  /* ─────────── testata ─────────── */
  .kr-header {
    position: sticky;
    top: 14px;
    z-index: 50;
    margin: 14px clamp(14px, 3vw, 36px) 0;
    background: rgba(10,11,12,.8);
    backdrop-filter: blur(14px) saturate(160%);
    -webkit-backdrop-filter: blur(14px) saturate(160%);
    border-radius: 999px;
    min-height: 60px;
    padding: 0 24px 0 26px;
    box-shadow: 0 10px 30px rgba(0,0,0,.3);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    border: 1px solid var(--line);
  }
  .kr-brand { display: inline-flex; align-items: center; gap: 13px; color: var(--white); white-space: nowrap; }
  .kr-mark {
    display: grid;
    place-items: center;
    width: 30px; height: 30px;
    border: 2px solid var(--yellow);
    border-radius: 50%;
    color: var(--yellow);
    font-family: 'Bodoni Moda', Georgia, serif;
    font-size: 12px;
    font-weight: 600;
  }
  .kr-brand-name { font-size: clamp(10px, 1vw, 13px); font-weight: 700; letter-spacing: .17em; text-transform: uppercase; }
  .kr-back {
    color: var(--dim);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
    transition: color .2s;
  }
  .kr-back:hover, .kr-back:focus-visible { color: var(--yellow); }

  /* ─────────── hero a tutta pagina ─────────── */
  .kr-hero {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    margin-top: -88px;
    padding-top: 88px;
  }

  .kr-hero-bg { position: absolute; inset: 0; z-index: 0; background: #101112; }
  .kr-hero-bg video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
    display: block;
  }
  .kr-hero-veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(0deg, rgba(6,7,8,.97) 0%, rgba(6,7,8,.84) 24%, rgba(6,7,8,.4) 52%, rgba(6,7,8,.35) 100%),
      linear-gradient(100deg, rgba(6,7,8,.6) 0%, rgba(6,7,8,.1) 42%, rgba(6,7,8,.05) 100%);
  }

  .kr-hero-content {
    position: relative;
    z-index: 2;
    width: 100%;
    padding: clamp(120px, 16vw, 200px) clamp(24px, 5vw, 82px) clamp(64px, 8vw, 104px);
    display: grid;
    grid-template-columns: minmax(0, 780px) minmax(0, 1fr);
    align-items: end;
    gap: clamp(36px, 5vw, 88px);
  }
  .kr-hero-inner { max-width: 780px; }

  .kr-eyebrow {
    margin: 0 0 clamp(14px, 1.8vw, 22px);
    color: var(--yellow);
    font-size: clamp(11px, 1vw, 14px);
    font-weight: 700;
    letter-spacing: .22em;
    text-transform: uppercase;
    text-shadow: 0 2px 14px rgba(0,0,0,.7);
  }

  .kr-hero h1 {
    margin: 0;
    font-family: 'Bodoni Moda', Georgia, serif;
    font-size: clamp(32px, 5.2vw, 72px);
    font-weight: 700;
    line-height: .94;
    letter-spacing: -.01em;
    text-shadow: 0 4px 30px rgba(0,0,0,.75);
  }

  .kr-role {
    margin: clamp(16px, 2vw, 24px) 0 0;
    color: var(--dim);
    font-size: clamp(12px, 1.05vw, 15px);
    font-weight: 700;
    letter-spacing: .06em;
    text-transform: uppercase;
    text-shadow: 0 2px 14px rgba(0,0,0,.7);
  }

  .kr-hero-bio {
    margin: clamp(22px, 2.6vw, 32px) 0 0;
    max-width: 66ch;
  }
  .kr-hero-bio p {
    margin: 0 0 1em;
    font-size: clamp(15px, 1.25vw, 18.5px);
    font-weight: 500;
    line-height: 1.58;
    color: rgba(255,255,255,.88);
    text-shadow: 0 2px 16px rgba(0,0,0,.75);
  }
  .kr-hero-bio p:last-child { margin-bottom: 0; }
  .kr-hero-bio em { color: var(--white); font-style: italic; }

  .kr-dropcap {
    float: left;
    margin: .02em .1em -.06em 0;
    font-family: 'Bodoni Moda', Georgia, serif;
    font-weight: 700;
    font-size: 3em;
    line-height: .82;
    color: var(--yellow);
  }

  .kr-cta {
    margin-top: clamp(28px, 3.4vw, 42px);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 26px;
    background: var(--yellow);
    color: var(--black);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
    transition: background .2s ease, transform .2s ease;
  }
  .kr-cta:hover, .kr-cta:focus-visible { background: #fff67a; transform: translateY(-2px); }

  .kr-scroll {
    position: absolute;
    z-index: 2;
    bottom: clamp(20px, 2.6vw, 32px);
    right: clamp(24px, 5vw, 82px);
    margin: 0;
    color: var(--dim);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: .2em;
    text-transform: uppercase;
    text-shadow: 0 2px 10px rgba(0,0,0,.7);
  }

  /* ─────────── filmografia in sovraimpressione, colonna destra dell'hero ─────────── */
  .kr-hero-filmo {
    justify-self: end;
    width: 100%;
    max-width: 520px;
    padding: clamp(20px, 2.2vw, 30px) clamp(20px, 2.2vw, 30px) clamp(16px, 1.8vw, 24px);
    background: linear-gradient(180deg, rgba(255,255,255,.055) 0%, rgba(255,255,255,.018) 100%);
    backdrop-filter: blur(7px) saturate(130%);
    -webkit-backdrop-filter: blur(7px) saturate(130%);
    border: 1px solid rgba(255,255,255,.13);
  }
  .kr-hero-filmo .kr-label {
    margin-bottom: 0;
    text-shadow: 0 2px 12px rgba(0,0,0,.7);
  }

  .kr-filmo-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: clamp(12px, 1.4vw, 18px);
  }
  .kr-filmo-count {
    margin: 0;
    color: rgba(255,255,255,.34);
    font-size: 9.5px;
    font-weight: 800;
    letter-spacing: .2em;
    text-transform: uppercase;
  }

  .kr-filmo-list { list-style: none; margin: 0; padding: 0; }
  .kr-filmo-list li {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: clamp(8px, 1vw, 14px);
    padding: clamp(9px, 1.1vw, 13px) 0;
    border-top: 1px solid rgba(255,255,255,.1);
    transition: border-color .25s ease;
  }
  .kr-filmo-list li:last-child { border-bottom: 1px solid rgba(255,255,255,.1); }
  .kr-filmo-list li:hover { border-top-color: rgba(255,255,255,.24); }

  .kr-filmo-num {
    color: rgba(255,255,255,.3);
    font-family: 'Bodoni Moda', Georgia, serif;
    font-style: italic;
    font-size: clamp(11px, .95vw, 13px);
    min-width: 2ch;
  }
  .kr-filmo-year {
    color: rgba(242,236,60,.72);
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: .06em;
    min-width: 4ch;
    text-shadow: 0 2px 10px rgba(0,0,0,.7);
    transition: color .25s ease;
  }
  .kr-filmo-title {
    flex: 1;
    min-width: 0;
    font-family: 'Bodoni Moda', Georgia, serif;
    font-size: clamp(15px, 1.25vw, 19px);
    font-weight: 400;
    color: rgba(255,255,255,.74);
    text-shadow: 0 2px 14px rgba(0,0,0,.75);
    transition: color .25s ease;
  }
  .kr-filmo-note {
    flex-basis: 100%;
    text-align: right;
    margin-top: 2px;
    color: rgba(255,255,255,.42);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    text-shadow: 0 2px 10px rgba(0,0,0,.7);
  }
  .kr-filmo-list li:hover .kr-filmo-title { color: var(--white); }
  .kr-filmo-list li:hover .kr-filmo-year { color: var(--yellow); }

  /* ─────────── il corto ─────────── */
  .kr-feature {
    padding: clamp(48px, 7vw, 96px) clamp(24px, 5vw, 82px);
    border-top: 1px solid var(--line);
  }
  .kr-feature-card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(32px, 4.4vw, 56px);
    background: linear-gradient(150deg, #14312e 0%, #0c0d0e 62%);
    border: 1px solid var(--line);
  }
  /* fotogramma del trailer in trasparenza, sotto al testo */
  .kr-feature-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: url('https://i.ytimg.com/vi/sblnh_nJzts/maxresdefault.jpg') center / cover no-repeat;
    opacity: .3;
  }
  .kr-feature-card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(100deg, rgba(8,9,10,.92) 0%, rgba(8,9,10,.66) 44%, rgba(8,9,10,.22) 100%);
  }
  .kr-feature-copy h2 {
    margin: 0;
    max-width: 22ch;
    font-family: 'Bodoni Moda', Georgia, serif;
    font-size: clamp(30px, 4vw, 52px);
    font-weight: 700;
    line-height: 1.05;
    text-wrap: balance;
  }
  .kr-feature-synopsis {
    margin: clamp(18px, 2.2vw, 26px) 0 0;
    max-width: 62ch;
    color: var(--dim);
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(18px, 1.6vw, 22px);
    font-style: italic;
    line-height: 1.5;
  }
  .kr-feature-badges {
    margin-top: clamp(22px, 2.6vw, 30px);
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .kr-feature-badges span {
    padding: 6px 14px;
    border: 1px solid rgba(255,255,255,.3);
    color: var(--white);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
    border-radius: 999px;
  }
  .kr-feature-meta {
    margin-top: clamp(20px, 2.4vw, 28px);
    display: flex;
    flex-wrap: wrap;
    gap: clamp(18px, 2.4vw, 32px);
  }
  .kr-feature-meta p {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 13px;
    font-weight: 700;
    color: var(--white);
  }
  .kr-feature-meta span {
    color: var(--faint);
    font-size: 9.5px;
    font-weight: 800;
    letter-spacing: .18em;
    text-transform: uppercase;
  }
  .kr-feature-link {
    margin-top: clamp(24px, 3vw, 34px);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 26px;
    background: var(--yellow);
    color: var(--black);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
    transition: background .2s ease, transform .2s ease;
  }
  .kr-feature-link:hover, .kr-feature-link:focus-visible { background: #fff67a; transform: translateY(-2px); }

  /* ─────────── trailer a tutta pagina ─────────── */
  .kr-trailer {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    border-top: 1px solid var(--line);
  }
  .kr-trailer-bg { position: absolute; inset: 0; z-index: 0; background: #000; }
  .kr-trailer-embed {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100vw;
    height: 56.25vw;
    min-height: 100vh;
    min-height: 100dvh;
    min-width: 177.78vh;
    min-width: 177.78dvh;
    transform: translate(-50%, -50%);
  }
  .kr-trailer-embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .kr-trailer-veil {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(0deg, rgba(6,7,8,.94) 0%, rgba(6,7,8,.55) 26%, rgba(6,7,8,.05) 55%, rgba(6,7,8,.3) 100%);
  }
  .kr-trailer-content {
    position: relative;
    z-index: 2;
    width: 100%;
    padding: clamp(24px, 5vw, 82px) clamp(24px, 5vw, 82px) clamp(64px, 8vw, 104px);
  }
  .kr-trailer-content h2 {
    margin: 8px 0 0;
    font-family: 'Bodoni Moda', Georgia, serif;
    font-size: clamp(34px, 5.4vw, 68px);
    font-weight: 700;
    line-height: 1.02;
    text-shadow: 0 4px 24px rgba(0,0,0,.8);
  }
  .kr-trailer-sub {
    margin: 12px 0 0;
    color: rgba(255,255,255,.78);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .04em;
    text-shadow: 0 2px 12px rgba(0,0,0,.8);
  }

  /* ─────────── responsive ─────────── */
  @media (max-width: 1080px) {
    .kr-hero-content {
      grid-template-columns: minmax(0, 1fr);
      gap: clamp(30px, 4.4vw, 48px);
    }
    .kr-hero-filmo {
      justify-self: stretch;
      max-width: 780px;
    }
  }

  @media (max-width: 640px) {
    .kr-header { margin: 10px 10px 0; padding: 0 16px 0 20px; }
    .kr-brand-name { display: none; }
    .kr-hero-content { padding-top: clamp(100px, 30vw, 140px); }
    .kr-filmo-list li { flex-direction: column; gap: 4px; }
    .kr-filmo-note { text-align: left; }
  }
</style>
