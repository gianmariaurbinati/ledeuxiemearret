---
import Layout from '../../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL.slice(0, -1) : import.meta.env.BASE_URL;

const rubriche = [
  {
    slug: 'comandante',
    titolo: 'Comandante',
    regista: 'Enrico Maisto, 2014',
    descrizione: "Il giudice e il militante. Un'amicizia attraverso gli anni di piombo.",
    img: '/img/comandante-bg.jpg',
    live: true,
    registaNome: 'Enrico Maisto',
    registaUrl: '/registi/enrico-maisto',
  },
  {
    slug: 'arianna',
    titolo: 'Arianna',
    regista: 'Arianna Lavagna, 2015',
    descrizione: "Prossimamente. La rubrica di Arianna Lavagna.",
    live: false,
    gradient: 'linear-gradient(135deg, #4a2b7a, #0e3a54)',
  },
  {
    slug: 'kripton',
    titolo: 'Kripton',
    regista: 'Francesco Munzi, 2024',
    descrizione: "Prossimamente. La rubrica di Francesco Munzi.",
    live: false,
    gradient: 'linear-gradient(135deg, #6d1f2f, #2b1f1f)',
    video: '/video/kripton-card-bg',
  },
];
---
<Layout title="Rubriche — Le deuxième arrêt">
  <section class="rubriche">
    <div class="page-media" style={`--rubriche-poster: url('${base}/video/rubriche-background-poster.jpg')`} aria-hidden="true">
      <video id="rubricheBackground" autoplay muted loop playsinline preload="auto" poster={`${base}/video/rubriche-background-poster.jpg`}>
        <source src={`${base}/video/rubriche-background.webm`} type="video/webm" />
        <source src={`${base}/video/rubriche-background.mp4`} type="video/mp4" />
      </video>
      <div class="page-scrim"></div>
    </div>

    <div class="inner">
      <header>
        <h1>Rubriche</h1>
        <div class="rule"></div>
        <p>Film compiuti che meritano una seconda lettura</p>
      </header>

      <div class="grid">
        {rubriche.map((r) => (
          <article class:list={['card', { placeholder: !r.live, 'has-video': !!r.video, 'has-image': !!r.img }]}>
            <a href={r.live ? `${base}/rubriche/${r.slug}` : '#'} class="card-link">
              <div class="card-image" style={!r.img && !r.video ? `background:${r.gradient}` : undefined}>
                {r.img && <div class="card-photo" style={`background-image:url('${base}${r.img}')`}></div>}
                {r.video && (
                  <video class="card-video" autoplay muted loop playsinline preload="auto" poster={`${base}${r.video}.jpg`} aria-hidden="true">
                    <source src={`${base}${r.video}.webm`} type="video/webm" />
                    <source src={`${base}${r.video}.mp4`} type="video/mp4" />
                  </video>
                )}
                {r.video && <div class="card-video-tint"></div>}
                {!r.live && <span class="badge-placeholder">In preparazione</span>}
                <div class="card-scrim"></div>
                <span class="card-tag">{r.regista}</span>
              </div>
              <div class="card-body">
                <h2>{r.titolo}</h2>
                <p>{r.descrizione}</p>
                <span class="cta">{r.live ? 'Leggi la rubrica →' : 'Presto →'}</span>
              </div>
            </a>
            {r.registaUrl && (
              <a href={`${base}${r.registaUrl}`} class="regista-link">
                <span class="regista-eyebrow">Biografia</span>
                <span class="regista-nome">{r.registaNome} →</span>
              </a>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>

<script>
  const rubricheBackground = document.getElementById('rubricheBackground') as HTMLVideoElement | null;

  if (rubricheBackground) {
    const ensurePlayback = () => {
      rubricheBackground.muted = true;
      rubricheBackground.loop = true;
      if (rubricheBackground.paused) rubricheBackground.play().catch(() => {});
    };

    ensurePlayback();
    rubricheBackground.addEventListener('canplay', ensurePlayback);
    rubricheBackground.addEventListener('ended', () => {
      rubricheBackground.currentTime = 0;
      ensurePlayback();
    });
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) ensurePlayback();
    });
  }

  document.querySelectorAll<HTMLVideoElement>('.card-video').forEach((video) => {
    const ensurePlayback = () => {
      video.muted = true;
      video.loop = true;
      if (video.paused) video.play().catch(() => {});
    };

    ensurePlayback();
    video.addEventListener('canplay', ensurePlayback);
    video.addEventListener('ended', () => {
      video.currentTime = 0;
      ensurePlayback();
    });
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) ensurePlayback();
    });
  });
</script>

<style>
  .rubriche {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    background: #111523;
    padding: clamp(72px,12vh,140px) 40px;
  }
  .page-media {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    background: #111523 var(--rubriche-poster) center / cover no-repeat;
  }
  .page-media video {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }
  .page-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(7,10,25,0.34) 0%, rgba(6,9,24,0.48) 100%),
      radial-gradient(circle at 50% 30%, rgba(10,15,36,0.08) 0%, rgba(4,7,20,0.42) 100%);
  }
  .inner {
    position: relative;
    z-index: 1;
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 64px;
  }
  header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
  }
  header h1 {
    margin: 0;
    font-size: clamp(48px, 6vw, 84px);
    font-family: 'Parisienne', cursive;
    font-weight: 400;
    color: #f7f1e4;
    text-align: center;
    letter-spacing: 1px;
    opacity: 0;
    transform: translateY(28px);
    animation: title-in 1.15s cubic-bezier(.16,1,.3,1) .08s forwards;
  }
  .rule {
    width: clamp(80px,10vw,160px);
    height: 1px;
    background: linear-gradient(90deg, transparent, #d4af37, transparent);
    transform: scaleX(0);
    animation: rule-in 1s cubic-bezier(.16,1,.3,1) .28s forwards;
  }
  header p {
    margin: 0;
    max-width: 700px;
    font-size: clamp(16px, 1.5vw, 22px);
    color: #d4af37;
    text-align: center;
    opacity: 0;
    transform: translateY(16px);
    animation: copy-in .9s cubic-bezier(.16,1,.3,1) .42s forwards;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 32px;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    opacity: 0;
    transform: translateY(42px) scale(.985);
    animation: card-in 1s cubic-bezier(.16,1,.3,1) forwards;
  }
  .card:nth-child(1) { animation-delay: .52s; }
  .card:nth-child(2) { animation-delay: .66s; }
  .card:nth-child(3) { animation-delay: .80s; }
  .card-link {
    display: flex;
    flex-direction: column;
    gap: 16px;
    text-decoration: none;
    transition: transform .55s cubic-bezier(.16,1,.3,1);
    cursor: pointer;
  }
  .card-link:hover { transform: translateY(-10px); }
  .card.placeholder { opacity: var(--card-placeholder-opacity); }
  .card.placeholder.has-video { opacity: 1; }
  .card.placeholder .card-link { cursor: default; }
  .card.placeholder .card-link:hover { transform: none; }

  .regista-link {
    align-self: flex-start;
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    padding: 7px 12px;
    border: 1px solid rgba(212,175,55,0.28);
    border-radius: 3px;
    background: rgba(0,0,0,0.22);
    transition: border-color .3s, background .3s;
  }
  .regista-link:hover {
    border-color: rgba(212,175,55,0.65);
    background: rgba(0,0,0,0.35);
  }
  .regista-eyebrow {
    font-size: 9px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--text-meta);
  }
  .regista-nome {
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #d4af37;
  }

  .card-image {
    position: relative;
    width: 100%;
    height: var(--card-media-height);
    border: var(--card-border);
    border-radius: var(--card-radius);
    overflow: hidden;
    background-color: #1a1a1a;
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
    justify-content: center;
    transform: translateZ(0);
    transition: border-color .45s ease, box-shadow .55s ease;
  }
  .card-image::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 4;
    background: linear-gradient(110deg, transparent 20%, rgba(247,241,228,.15) 46%, transparent 72%);
    transform: translateX(-125%);
    transition: transform .9s cubic-bezier(.16,1,.3,1);
    pointer-events: none;
  }
  .card-link:hover .card-image {
    border-color: rgba(212,175,55,.62);
    box-shadow: 0 24px 54px rgba(0,0,0,.34);
  }
  .card-link:hover .card-image::after {
    transform: translateX(125%);
  }
  .card-scrim {
    position: absolute;
    inset: 0;
    background: var(--card-scrim);
  }
  .card-tag {
    position: absolute;
    bottom: 12px;
    left: 12px;
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #d4af37;
    font-weight: 600;
  }
  .badge-placeholder {
    font-size: 14px;
    letter-spacing: 1px;
    color: rgba(247,241,228,0.4);
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .card-body h2 {
    margin: 0;
    font-size: clamp(18px, 2vw, 26px);
    font-weight: 600;
    letter-spacing: 1px;
    color: #f7f1e4;
    font-family: 'Cinzel', Georgia, serif;
    transition: color .35s ease, letter-spacing .45s cubic-bezier(.16,1,.3,1);
  }
  .card-link:hover .card-body h2 {
    color: #edcd63;
    letter-spacing: 1.8px;
  }
  .card-body p {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: #b8a88a;
  }
  .cta {
    margin-top: 8px;
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #d4af37;
    font-weight: 500;
  }

  .card-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  .card-video-tint {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, var(--card-video-tint-top) 0%, var(--card-video-tint-mid) 55%, var(--card-video-tint-bottom) 100%);
  }
  .card-image .card-scrim { z-index: 2; }
  .card-image .card-tag { z-index: 3; }
  .badge-placeholder { position: relative; z-index: 3; }

  @keyframes title-in {
    to { opacity: 1; transform: translateY(0); }
  }
  .card-photo {
    position: absolute;
    inset: -5%;
    z-index: 0;
    background-position: center;
    background-size: cover;
    will-change: transform;
    animation: comandante-drift 15s ease-in-out infinite alternate;
    transition: filter .7s ease;
  }
  .card-link:hover .card-photo { filter: contrast(1.04) brightness(1.05); }
  @keyframes rule-in {
    to { transform: scaleX(1); }
  }
  @keyframes copy-in {
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes card-in {
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  @keyframes comandante-drift {
    from { transform: scale(1.02) translate3d(-1.2%, .3%, 0); }
    to { transform: scale(1.11) translate3d(1.4%, -1.2%, 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .card-video { display: none; }
    .card-photo { animation: none; transform: scale(1.04); }
    .page-media video { display: none; }
    header h1,
    .rule,
    header p,
    .card {
      opacity: 1;
      transform: none;
      animation: none;
    }
    .card-link,
    .card-image,
    .card-image::after,
    .card-body h2 {
      transition: none;
    }
  }
</style>
