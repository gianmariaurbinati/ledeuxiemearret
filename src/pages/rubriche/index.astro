---
import Layout from '../../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL.slice(0, -1) : import.meta.env.BASE_URL;
---

<Layout title="Rubriche — Le deuxième arrêt">
  <main class="rubriche-page">
    <section class="hero" aria-labelledby="kripton-title">
      <div class="hero-media" style={`--hero-poster: url('${base}/video/kripton-card-bg.jpg')`} aria-hidden="true">
        <video id="kriptonHero" autoplay muted loop playsinline preload="auto" poster={`${base}/video/kripton-card-bg.jpg`}>
          <source src={`${base}/video/kripton-card-bg.webm`} type="video/webm" />
          <source src={`${base}/video/kripton-card-bg.mp4`} type="video/mp4" />
        </video>
        <div class="hero-veil"></div>
      </div>

      <header class="site-header">
        <a href={`${base}/`} class="brand" aria-label="Le deuxième arrêt — Home">
          <span>Le deuxième arrêt</span>
        </a>
        <nav aria-label="Navigazione principale">
          <a href={`${base}/`}>Home</a>
          <a href={`${base}/menu`}>Menu</a>
          <a href={`${base}/rubriche`} class="is-active">Rubriche</a>
          <a href={`${base}/news`}>News</a>
          <span>Prossimamente</span>
        </nav>
      </header>

      <div class="hero-copy">
        <p class="eyebrow">Prossimamente</p>
        <h1 id="kripton-title">Kripton</h1>
        <p class="byline">Francesco Munzi <span></span> 2024</p>
        <p class="description">Munzi e Travaglioli mostrano i muscoli lasciando il vuoto. Tandem da brividi.</p>
        <span class="hero-cta" aria-label="Kripton, prossimamente">In preparazione</span>
      </div>
    </section>

    <section class="catalogue" aria-labelledby="catalogue-title">
      <div class="catalogue-heading">
        <h2 id="catalogue-title"><span aria-hidden="true">•</span> Le nostre rubriche</h2>
        <p>Storie scelte da Le deuxième arrêt</p>
      </div>

      <div class="poster-row">
        <article class="poster-card is-live">
          <a href={`${base}/rubriche/comandante`}>
            <div class="poster-frame">
              <img src={`${base}/img/comandante-cover.jpg`} alt="Locandina del film Comandante" />
              <div class="poster-shade"></div>
              <span class="poster-status">Leggi</span>
            </div>
            <h3>Comandante</h3>
            <p>Enrico Maisto, 2014</p>
          </a>
        </article>

        <article class="poster-card">
          <div class="poster-frame">
            <img src={`${base}/img/futura-cover.jpg`} alt="Locandina del film Futura" />
            <div class="poster-shade"></div>
            <span class="poster-status">Prossimamente</span>
          </div>
          <h3>Futura</h3>
          <p>Pietro Marcello, Francesco Munzi, Alice Rohrwacher</p>
        </article>

        {Array.from({ length: 5 }).map((_, index) => (
          <article class="poster-card is-empty" aria-label={`Spazio rubrica ${index + 3}, prossimamente`}>
            <div class="poster-frame"><span class="empty-mark"></span></div>
            <h3 aria-hidden="true">&nbsp;</h3>
            <p aria-hidden="true">&nbsp;</p>
          </article>
        ))}
      </div>
    </section>
  </main>
</Layout>

<script>
  const kriptonHero = document.getElementById('kriptonHero') as HTMLVideoElement | null;

  if (kriptonHero) {
    const ensurePlayback = () => {
      kriptonHero.muted = true;
      kriptonHero.loop = true;
      if (kriptonHero.paused) kriptonHero.play().catch(() => {});
    };

    ensurePlayback();
    kriptonHero.addEventListener('canplay', ensurePlayback);
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) ensurePlayback();
    });
  }
</script>

<style>
  .rubriche-page {
    min-height: 100vh;
    overflow-x: hidden;
    background: #08090a;
    color: #fff;
    font-family: Arial, Helvetica, sans-serif;
  }

  .hero {
    position: relative;
    min-height: clamp(520px, 66vh, 720px);
    overflow: hidden;
    background: #11171b;
  }

  .hero-media {
    position: absolute;
    inset: 0;
  }

  .hero-media video {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
  }

  .hero-veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(4, 9, 12, .84) 0%, rgba(4, 9, 12, .48) 32%, rgba(4, 9, 12, .08) 68%),
      linear-gradient(180deg, rgba(4, 7, 9, .47) 0%, transparent 24%, transparent 67%, rgba(6, 7, 8, .92) 100%);
  }

  .site-header {
    position: relative;
    z-index: 2;
    min-height: 72px;
    padding: 0 clamp(24px, 3.2vw, 52px) 0 52px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    border-bottom: 1px solid rgba(255, 255, 255, .1);
    background: rgba(4, 9, 12, .18);
    backdrop-filter: blur(4px);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    color: #fff;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 23px;
    font-style: italic;
    font-weight: 500;
    white-space: nowrap;
  }

  .brand img {
    width: 35px;
    height: 35px;
    object-fit: contain;
  }

  .site-header nav {
    display: flex;
    align-items: center;
    gap: clamp(18px, 2.5vw, 40px);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .03em;
  }

  .site-header nav a,
  .site-header nav span {
    position: relative;
    padding: 29px 0 27px;
    color: rgba(255, 255, 255, .72);
    white-space: nowrap;
  }

  .site-header nav a:hover,
  .site-header nav a:focus-visible,
  .site-header nav .is-active { color: #fff; }

  .site-header nav .is-active::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 20px;
    height: 1px;
    background: #e34525;
  }

  .site-header nav span { color: rgba(255, 255, 255, .36); }

  .hero-copy {
    position: absolute;
    z-index: 2;
    left: clamp(30px, 5.2vw, 82px);
    top: 52%;
    width: min(430px, calc(100vw - 60px));
    transform: translateY(-42%);
    text-shadow: 0 3px 20px rgba(0, 0, 0, .75);
  }

  .eyebrow {
    margin: 0 0 8px;
    color: rgba(255, 255, 255, .67);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .hero-copy h1 {
    margin: 0;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(54px, 5vw, 78px);
    font-weight: 500;
    line-height: .98;
    letter-spacing: -.025em;
  }

  .byline {
    margin: 18px 0 0;
    display: flex;
    align-items: center;
    gap: 12px;
    color: rgba(255, 255, 255, .9);
    font-size: 11px;
    font-weight: 700;
  }

  .byline span {
    width: 1px;
    height: 13px;
    background: rgba(255, 255, 255, .4);
  }

  .description {
    margin: 17px 0 0;
    color: rgba(255, 255, 255, .75);
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(18px, 1.5vw, 22px);
    font-weight: 500;
    line-height: 1.35;
  }

  .hero-cta {
    margin-top: 25px;
    display: inline-flex;
    padding: 12px 20px;
    border-radius: 2px;
    background: #e34525;
    color: #fff;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .04em;
    text-transform: uppercase;
    box-shadow: 0 9px 24px rgba(0, 0, 0, .28);
  }

  .catalogue {
    position: relative;
    z-index: 3;
    padding: 16px 0 38px;
    background: #08090a;
  }

  .catalogue-heading {
    padding: 0 clamp(26px, 4.2vw, 66px) 14px;
    display: flex;
    align-items: baseline;
    gap: 14px;
  }

  .catalogue-heading h2 {
    margin: 0;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: .015em;
  }

  .catalogue-heading h2 span { color: #e34525; }

  .catalogue-heading p {
    margin: 0;
    color: rgba(255, 255, 255, .35);
    font-size: 9px;
  }

  .poster-row {
    padding: 0 clamp(26px, 4.2vw, 66px) 12px;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: clamp(142px, 13.5vw, 208px);
    gap: clamp(16px, 1.7vw, 27px);
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scrollbar-color: rgba(255, 255, 255, .22) transparent;
    scrollbar-width: thin;
  }

  .poster-card {
    min-width: 0;
    color: #fff;
  }

  .poster-card > a { display: block; color: inherit; }

  .poster-frame {
    position: relative;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    background: linear-gradient(145deg, #171a1c, #0d0e0f);
    border: 1px solid rgba(255, 255, 255, .08);
    box-shadow: 0 15px 34px rgba(0, 0, 0, .22);
  }

  .poster-frame img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform .65s cubic-bezier(.16, 1, .3, 1), filter .45s ease;
  }

  .poster-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 64%, rgba(0, 0, 0, .68) 100%);
  }

  .poster-status {
    position: absolute;
    left: 10px;
    bottom: 9px;
    color: rgba(255, 255, 255, .86);
    font-size: 8px;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .poster-card h3 {
    margin: 10px 0 0;
    overflow: hidden;
    color: rgba(255, 255, 255, .9);
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.05;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .poster-card p {
    margin: 5px 0 0;
    overflow: hidden;
    color: rgba(255, 255, 255, .36);
    font-size: 8px;
    line-height: 1.3;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .is-live a:hover .poster-frame img,
  .is-live a:focus-visible .poster-frame img {
    transform: scale(1.045);
    filter: brightness(1.08);
  }

  .is-live a:hover h3,
  .is-live a:focus-visible h3 { color: #e8c85d; }

  .is-empty .poster-frame {
    display: grid;
    place-items: center;
    background:
      linear-gradient(140deg, rgba(255, 255, 255, .025), transparent 58%),
      #0f1112;
    border-color: rgba(255, 255, 255, .045);
    box-shadow: none;
  }

  .empty-mark {
    width: 18px;
    height: 1px;
    background: rgba(255, 255, 255, .09);
  }

  @media (max-width: 760px) {
    .hero { min-height: 620px; }

    .site-header {
      min-height: 66px;
      padding: 0 18px 0 52px;
    }

    .brand span { display: none; }
    .brand img { width: 33px; height: 33px; }

    .site-header nav {
      max-width: calc(100vw - 78px);
      justify-content: flex-start;
      gap: 22px;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .site-header nav::-webkit-scrollbar { display: none; }
    .site-header nav a,
    .site-header nav span { padding: 27px 0 25px; }

    .hero-copy {
      left: 24px;
      top: 54%;
      width: calc(100vw - 48px);
    }

    .hero-veil {
      background:
        linear-gradient(90deg, rgba(4, 9, 12, .72), rgba(4, 9, 12, .12)),
        linear-gradient(180deg, rgba(4, 7, 9, .38), transparent 25%, rgba(6, 7, 8, .9) 100%);
    }

    .catalogue { padding-top: 18px; }
    .catalogue-heading { padding-inline: 22px; }
    .catalogue-heading p { display: none; }
    .poster-row {
      padding-inline: 22px;
      grid-auto-columns: 148px;
      gap: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-media video { display: none; }
    .hero-media { background: #11171b var(--hero-poster) center / cover no-repeat; }
    .poster-frame img { transition: none; }
  }
</style>