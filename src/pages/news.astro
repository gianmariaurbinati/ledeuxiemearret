---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL.slice(0, -1) : import.meta.env.BASE_URL;

// ─────────────────────────────────────────────────────────────
// NOTIZIE — per aggiungerne una, copia un blocco e cambia i campi.
//   sezione  : etichetta della sezione (serve solo alla navigazione in alto)
//   inNav    : true = compare nel menu in alto
//   regista  : è ciò che si legge in giallo sopra il titolo
//   articolo : se presente, il pannello porta all'articolo interno
//              invece che dritto al trailer (il trailer resta linkato
//              dentro la pagina dell'articolo)
// ─────────────────────────────────────────────────────────────
const notizie = [
  {
    anchor: 'al-cinema',
    sezione: 'Al cinema',
    inNav: false,
    regista: 'Alysa Nahmias',
    titolo: 'Cookie Queens',
    trailer: 'https://youtu.be/nnSQS43Eil8?si=YAmn9Nftoi8B242K',
    articolo: `${base}/news/cookie-queens`,
    img: `${base}/img/news-cookie-queens.jpg`,
    fuoco: '50% 58%',
  },
  {
    anchor: 'canali-alternativi',
    sezione: 'Canali alternativi',
    inNav: true,
    regista: 'Umair Bilal',
    titolo: 'As Light, As Air',
    trailer: 'https://www.youtube.com/watch?v=QqeWzxaxOCg',
    img: `${base}/img/news-as-light-as-air.png`,
    fuoco: '50% 42%',
  },
  {
    anchor: 'selezione-corti',
    sezione: 'Selezione corti',
    inNav: true,
    regista: 'Tizza Covi e Rainer Frimmel',
    titolo: 'Vera',
    trailer: 'https://youtu.be/fbGI9gc6EUA?si=d8O00O_st_upEw56',
    img: `${base}/img/news-vera.jpg`,
    fuoco: '58% 45%',
  },
];
---
<Layout title="Film News — Le Deuxième Arrêt">
  <main class="filmnews" id="top">

    <!-- ═══════════════ TESTATA ═══════════════ -->
    <header class="fn-header">
      <a href={`${base}/`} class="fn-brand" aria-label="Le Deuxième Arrêt, home">
        <span class="fn-mark" aria-hidden="true">II</span>
        <span class="fn-brand-name">Le deuxième arrêt</span>
      </a>

      <nav class="fn-nav" aria-label="Navigazione principale">
        {notizie.filter((n) => n.inNav).map((n) => <a href={`#${n.anchor}`}>{n.sezione}</a>)}
      </nav>
    </header>

    <!-- ═══════════════ APERTURA ═══════════════ -->
    <section class="fn-hero" aria-labelledby="fn-title">
      <div class="fn-collage" aria-hidden="true">
        <div class="fn-panel fn-panel--a"><span>The<br />last<br />frame</span></div>
        <div class="fn-panel fn-panel--b">
          <video id="fnHeroVideo" src={`${base}/video/news-hero.mp4`} autoplay muted loop playsinline preload="auto"></video>
        </div>
        <div class="fn-panel fn-panel--c"><span>Nuovo<br />cinema</span></div>
      </div>
      <div class="fn-veil" aria-hidden="true"></div>

      <p class="fn-clock"><span id="fnClock">Roma</span></p>

      <div class="fn-hero-copy">
        <p class="fn-eyebrow">Film News <span aria-hidden="true">·</span> <span id="fnDate">12 agosto 2026</span></p>

        <h1 id="fn-title">
          Il cinema nascosto.
          <em>Proposte dal mondo.</em>
        </h1>

        <p class="fn-sub">Notizie, immagini e idee per chi guarda oltre i titoli di coda.</p>

        <a href="#news" class="fn-cta">Entra nelle news</a>
      </div>

      <p class="fn-scroll">Scorri per le news</p>
      <p class="fn-vol">Vol. 01 — Agosto</p>
    </section>

    <!-- ═══════════════ NOTIZIE ═══════════════ -->
    <section class="fn-news" id="news" aria-labelledby="fn-news-title">
      <h2 id="fn-news-title" class="fn-visually-hidden">Notizie in evidenza</h2>

      <div class="fn-row">
        {notizie.map((n, i) => (
          <article class="fn-panel-card" id={n.anchor}>
            <a href={n.articolo ?? n.trailer} class="fn-news-badge" aria-label={`Leggi l'articolo su ${n.titolo}`}>
              <span class="fn-news-icon" aria-hidden="true">📖</span>
              <span class="fn-news-text">
                News
                <span class="fn-news-dot" aria-hidden="true"></span>
              </span>
              <span class="fn-news-read">Leggi <span aria-hidden="true">→</span></span>
            </a>
            <a
              href={n.articolo ?? n.trailer}
              class="fn-panel-link"
              aria-label={n.articolo ? `Leggi l'articolo su ${n.titolo}` : `Guarda il trailer di ${n.titolo} su YouTube`}
            >
              <img src={n.img} alt="" style={`object-position:${n.fuoco}`} />
              <span class="fn-panel-shade" aria-hidden="true"></span>
              <span class="fn-panel-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>

              <div class="fn-panel-copy">
                <p class="fn-panel-dir">{n.regista}</p>
                <h3>{n.titolo}</h3>
                <p class="fn-panel-hint">{n.articolo ? "Leggi l'articolo" : 'Scopri di più'}</p>
              </div>
            </a>

            <a
              href={n.trailer}
              target="_blank"
              rel="noopener"
              class="fn-panel-play"
              aria-label={`Guarda il trailer di ${n.titolo} su YouTube`}
            >
              <span class="fn-play" aria-hidden="true">▶</span>
            </a>
          </article>
        ))}
      </div>
    </section>

    <!-- ═══════════════ CHIUSURA ═══════════════ -->
    <section class="fn-closing" aria-labelledby="fn-closing-title">
      <p class="fn-closing-brand">Le Deuxième Arrêt</p>
      <h2 id="fn-closing-title">
        Il cinema non vive solo ad Hollywood.
        <em>Sguardi diversi per capire il mondo.</em>
      </h2>

      <figure class="fn-quote">
        <blockquote>
          <p>Hollywood è un posto dove ti pagano migliaia di dollari per un bacio, e cinquanta centesimi per l'anima.</p>
        </blockquote>
        <figcaption>Marilyn Monroe</figcaption>
      </figure>
    </section>

  </main>
</Layout>

<script>
  // Orologio e data di Roma, stesso comportamento della Home
  const clockEl = document.getElementById('fnClock');
  const dateEl = document.getElementById('fnDate');

  const tick = () => {
    const now = new Date();
    if (clockEl) {
      const ora = new Intl.DateTimeFormat('it-IT', {
        hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Rome',
      }).format(now);
      clockEl.textContent = `Roma ore ${ora}`;
    }
    if (dateEl) {
      dateEl.textContent = new Intl.DateTimeFormat('it-IT', {
        day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Rome',
      }).format(now);
    }
  };

  tick();
  setInterval(tick, 30_000);

  // Il video dell'apertura deve ripartire anche al ritorno sulla scheda
  const heroVideo = document.getElementById('fnHeroVideo') as HTMLVideoElement | null;

  if (heroVideo) {
    const ensurePlayback = () => {
      heroVideo.muted = true;
      heroVideo.loop = true;
      if (heroVideo.paused) heroVideo.play().catch(() => {});
    };

    ensurePlayback();
    heroVideo.addEventListener('canplay', ensurePlayback);
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) ensurePlayback();
    });
  }
</script>

<style>
  .filmnews {
    --fn-black:  #08090a;
    --fn-yellow: #f2ec3c;
    --fn-white:  #ffffff;
    --fn-dim:    rgba(255,255,255,.62);
    --fn-line:   rgba(255,255,255,.15);

    min-height: 100vh;
    overflow-x: hidden;
    background: var(--fn-black);
    color: var(--fn-white);
    font-family: Arial, Helvetica, sans-serif;
  }

  .fn-visually-hidden {
    position: absolute;
    width: 1px; height: 1px;
    margin: -1px; padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ─────────── testata ─────────── */
  .fn-header {
    position: absolute;
    z-index: 5;
    inset: 0 0 auto 0;
    min-height: 74px;
    padding: 0 clamp(20px, 3.2vw, 46px) 0 52px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(16px, 3vw, 40px);
    border-bottom: 1px solid var(--fn-line);
  }

  .fn-brand {
    display: inline-flex;
    align-items: center;
    gap: 13px;
    color: var(--fn-white);
    white-space: nowrap;
  }
  .fn-mark {
    display: grid;
    place-items: center;
    width: 32px; height: 32px;
    border: 2px solid var(--fn-yellow);
    border-radius: 50%;
    color: var(--fn-yellow);
    font-family: 'Bodoni Moda', Georgia, serif;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: .04em;
  }
  .fn-brand-name {
    font-size: clamp(11px, 1vw, 14px);
    font-weight: 700;
    letter-spacing: .17em;
    text-transform: uppercase;
  }

  .fn-nav {
    display: flex;
    align-items: center;
    gap: clamp(14px, 2.4vw, 38px);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .fn-nav::-webkit-scrollbar { display: none; }
  .fn-nav a {
    padding: 26px 0;
    color: var(--fn-white);
    font-size: clamp(10px, .85vw, 12.5px);
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: color .2s ease;
  }
  .fn-nav a:hover, .fn-nav a:focus-visible { color: var(--fn-yellow); }

  /* ─────────── apertura ─────────── */
  .fn-hero {
    position: relative;
    min-height: clamp(560px, 92vh, 900px);
    padding: 128px clamp(24px, 5vw, 82px) clamp(56px, 7vw, 92px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    background: #101112;
  }

  .fn-collage {
    position: absolute;
    inset: -8% -4%;
    display: flex;
    gap: 10px;
    transform: rotate(-4deg) scale(1.14);
  }
  .fn-panel {
    flex: 1;
    display: grid;
    place-items: center;
    background-size: cover;
    background-position: center;
  }
  .fn-panel span {
    font-family: 'Anton', Arial Black, sans-serif;
    font-size: clamp(34px, 5.4vw, 88px);
    line-height: .9;
    letter-spacing: .005em;
    text-transform: uppercase;
    transform: rotate(-4deg);
  }
  .fn-panel--a { background: #c9c6bf; }
  .fn-panel--a span { color: #7d1420; }
  .fn-panel--c { background: #10514c; }
  .fn-panel--c span { color: var(--fn-yellow); }

  /* pannello nero centrale: ci vive il video, adattato alla forma */
  .fn-panel--b {
    position: relative;
    overflow: hidden;
    background: #0a0b0c;
  }
  .fn-panel--b video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .fn-veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(6,7,8,.9) 0%, rgba(6,7,8,.6) 44%, rgba(6,7,8,.22) 100%),
      linear-gradient(180deg, rgba(6,7,8,.66) 0%, transparent 30%, transparent 62%, rgba(6,7,8,.94) 100%);
  }

  .fn-clock {
    position: absolute;
    z-index: 3;
    top: 96px;
    right: clamp(24px, 5vw, 82px);
    margin: 0;
    color: var(--fn-dim);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .2em;
    text-transform: uppercase;
  }

  .fn-hero-copy { position: relative; z-index: 3; max-width: min(880px, 100%); }

  .fn-eyebrow {
    margin: 0 0 clamp(14px, 1.8vw, 24px);
    color: var(--fn-yellow);
    font-size: clamp(11px, 1vw, 14px);
    font-weight: 700;
    letter-spacing: .22em;
    text-transform: uppercase;
  }

  .fn-hero h1 {
    margin: 0;
    font-family: 'Anton', Arial Black, sans-serif;
    font-size: clamp(32px, 5vw, 72px);
    font-weight: 400;
    line-height: .95;
    letter-spacing: .002em;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .fn-hero h1 em {
    display: block;
    margin-top: .38em;
    color: var(--fn-yellow);
    font-family: 'Playfair Display', Georgia, serif;
    font-style: italic;
    font-weight: 900;
    font-size: .88em;
    letter-spacing: .09em;
    text-transform: none;
  }

  .fn-sub {
    margin: clamp(20px, 2.4vw, 32px) 0 0;
    max-width: 46ch;
    color: var(--fn-dim);
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(18px, 1.6vw, 24px);
    line-height: 1.4;
  }

  .fn-cta {
    margin-top: clamp(24px, 3vw, 38px);
    display: inline-flex;
    padding: 9px 24px;
    background: rgba(242, 236, 60, .82);
    color: var(--fn-black);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .14em;
    text-transform: uppercase;
    backdrop-filter: blur(2px);
    transition: background .2s ease, transform .2s ease;
  }
  .fn-cta:hover { background: rgba(255, 246, 122, .95); transform: translateY(-2px); }

  .fn-scroll, .fn-vol {
    position: absolute;
    z-index: 3;
    bottom: clamp(26px, 3.4vw, 44px);
    margin: 0;
    color: var(--fn-dim);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: .2em;
    text-transform: uppercase;
  }
  .fn-scroll { left: clamp(24px, 5vw, 82px); }
  .fn-vol    { right: clamp(24px, 5vw, 82px); color: var(--fn-yellow); }

  /* ─────────── notizie: pannelli a tutta larghezza ─────────── */
  .fn-news { background: var(--fn-black); }

  .fn-row {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: clamp(280px, 32vw, 440px);
    gap: 2px;
    background: var(--fn-black);
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scrollbar-color: rgba(255, 255, 255, .22) transparent;
    scrollbar-width: thin;
  }

  .fn-panel-card { position: relative; scroll-margin-top: 84px; }

  /* ─────────── cartellino "News": link separato verso l'articolo ─────────── */
  .fn-news-badge {
    position: absolute;
    top: clamp(14px, 1.6vw, 22px);
    left: clamp(14px, 1.6vw, 22px);
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 14px 8px 11px;
    border-radius: 999px;
    background: rgba(8,9,10,.85);
    border: 1px solid rgba(255,255,255,.28);
    box-shadow: 0 6px 18px rgba(0,0,0,.45);
    transition: transform .2s ease, border-color .2s ease, background .2s ease;
  }
  .fn-news-badge:hover, .fn-news-badge:focus-visible {
    transform: translateY(-2px);
    border-color: var(--fn-yellow);
    background: rgba(8,9,10,.95);
  }

  .fn-news-icon { font-size: 14px; line-height: 1; }

  .fn-news-text {
    position: relative;
    color: var(--fn-white);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .13em;
    text-transform: uppercase;
  }

  /* "Leggi →" sobrio: più piccolo e tenue del testo "News" */
  .fn-news-read {
    padding-left: 8px;
    margin-left: 8px;
    border-left: 1px solid rgba(255,255,255,.25);
    color: rgba(255,255,255,.58);
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: .04em;
    text-transform: none;
  }
  .fn-news-read span { display: inline-block; }

  /* il pallino siede sulla parola "News", angolo in alto a destra */
  .fn-news-dot {
    position: absolute;
    top: -6px;
    right: -9px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ff3b30;
    border: 1.5px solid rgba(8,9,10,.85);
    animation: fn-news-pulse 1.5s ease-in-out infinite;
  }

  @keyframes fn-news-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(255,59,48,.7); opacity: 1; }
    50% { box-shadow: 0 0 0 7px rgba(255,59,48,0); opacity: .5; }
  }

  .fn-panel-link {
    position: relative;
    display: block;
    aspect-ratio: 11 / 10;
    overflow: hidden;
    color: inherit;
    background: #121314;
  }

  .fn-panel-card img {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform .7s cubic-bezier(.16,1,.3,1);
  }

  .fn-panel-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,.34) 0%, transparent 26%, transparent 44%, rgba(0,0,0,.82) 100%);
  }

  .fn-panel-num {
    position: absolute;
    top: clamp(16px, 1.8vw, 28px);
    right: clamp(18px, 2vw, 32px);
    color: var(--fn-yellow);
    font-family: 'Bodoni Moda', Georgia, serif;
    font-style: italic;
    font-size: clamp(22px, 2.1vw, 34px);
    line-height: 1;
  }

  .fn-panel-copy {
    position: absolute;
    left: clamp(18px, 2.2vw, 40px);
    right: clamp(18px, 2.2vw, 40px);
    bottom: clamp(12px, 1.5vw, 20px);
  }

  .fn-panel-dir {
    margin: 0;
    color: var(--fn-yellow);
    font-size: clamp(10px, .95vw, 14px);
    font-weight: 800;
    letter-spacing: .15em;
    text-transform: uppercase;
  }

  .fn-panel-card h3 {
    margin: clamp(6px, .8vw, 12px) 0 clamp(14px, 1.7vw, 26px);
    color: var(--fn-white);
    font-family: 'Bodoni Moda', Georgia, serif;
    font-size: clamp(26px, 3vw, 48px);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -.015em;
  }

  .fn-panel-hint {
    margin: 0;
    color: var(--fn-dim);
    font-size: clamp(10px, .95vw, 14px);
    font-weight: 800;
    letter-spacing: .11em;
    text-transform: uppercase;
  }

  .fn-panel-link:hover img,
  .fn-panel-link:focus-visible img { transform: scale(1.045); }

  /* ─────────── pulsante play: link indipendente verso il trailer ─────────── */
  .fn-panel-play {
    position: absolute;
    z-index: 3;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    width: clamp(64px, 7vw, 96px);
    height: clamp(64px, 7vw, 96px);
    border: 3px solid #fff;
    border-radius: 50%;
    background: rgba(8,9,10,.4);
    box-shadow: 0 8px 26px rgba(0,0,0,.45);
    transition: transform .25s ease, background .25s ease;
  }
  .fn-panel-play:hover, .fn-panel-play:focus-visible {
    transform: translate(-50%, -50%) scale(1.08);
    background: var(--fn-yellow);
    border-color: var(--fn-yellow);
  }
  .fn-panel-play:hover .fn-play, .fn-panel-play:focus-visible .fn-play { color: var(--fn-black); }

  .fn-play {
    padding-left: 6px;
    color: #fff;
    font-size: clamp(22px, 2.2vw, 32px);
    transition: color .25s ease;
  }

  /* ─────────── chiusura ─────────── */
  .fn-closing {
    padding: clamp(56px, 8vw, 116px) clamp(24px, 5vw, 82px) clamp(64px, 8vw, 120px);
    background: var(--fn-white);
    color: #14130f;
  }
  .fn-closing-brand {
    margin: 0 0 clamp(16px, 2vw, 26px);
    color: var(--fn-yellow);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .24em;
    text-transform: uppercase;
  }
  .fn-closing h2 {
    margin: 0;
    max-width: 20ch;
    font-family: 'Archivo Black', Arial Black, sans-serif;
    font-size: clamp(30px, 4.4vw, 62px);
    font-weight: 400;
    line-height: .96;
    letter-spacing: -.022em;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .fn-closing h2 em {
    display: block;
    margin-top: clamp(56px, 7vw, 96px);
    color: #10514c;
    font-family: 'Bodoni Moda', Georgia, serif;
    font-style: italic;
    font-weight: 600;
    text-transform: none;
    letter-spacing: -.005em;
  }

  .fn-quote {
    margin: clamp(38px, 5vw, 66px) 0 0;
    padding-top: clamp(24px, 3vw, 38px);
    border-top: 1px solid rgba(20,19,15,.2);
    max-width: 62ch;
  }
  .fn-quote blockquote { margin: 0; }
  .fn-quote p {
    margin: 0;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(20px, 2vw, 30px);
    font-style: italic;
    font-weight: 400;
    line-height: 1.36;
    text-wrap: pretty;
  }
  .fn-quote figcaption {
    margin-top: 16px;
    color: rgba(20,19,15,.6);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .2em;
    text-transform: uppercase;
  }

  /* ─────────── tablet ─────────── */
  @media (max-width: 1000px) {
    .fn-panel-link { aspect-ratio: 4 / 3; }
  }

  /* ─────────── mobile ─────────── */
  @media (max-width: 660px) {
    .fn-header { min-height: 66px; padding: 0 18px 0 52px; gap: 14px; }
    .fn-brand-name { display: none; }
    .fn-nav a { padding: 22px 0; }

    .fn-hero {
      min-height: 82vh;
      padding-top: 112px;
      justify-content: flex-end;
    }
    .fn-collage { transform: rotate(-6deg) scale(1.5); }
    .fn-clock { top: 84px; right: 20px; }
    .fn-scroll, .fn-vol { position: static; display: block; margin-top: 26px; }
    .fn-vol { margin-top: 6px; }

    .fn-panel-link { aspect-ratio: 3 / 2; }
  }

  @media (prefers-reduced-motion: reduce) {
    .fn-panel-card img, .fn-play, .fn-arrow, .fn-cta { transition: none; }
