---
interface Props {
  title: string;
}
const { title } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL.slice(0, -1) : import.meta.env.BASE_URL;
---
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Cormorant:ital@1&family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,500;1,6..96,400;1,6..96,600&family=Archivo+Black&family=Anton&family=Playfair+Display:ital,wght@1,700;1,900&family=Cinzel:wght@400;500&display=swap" rel="stylesheet">
  </head>
  <body>
    <a href={`${base}/`} aria-label="Le deuxième arrêt — Home" style="position:fixed;z-index:10000;top:9px;left:4px;width:44px;height:auto;display:block;line-height:0;">
      <img src={`${base}/img/logo-perfetto-transparent.png`} alt="Le deuxième arrêt" style="display:block;width:44px;max-width:44px;height:auto;" />
    </a>
    <slot />
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
